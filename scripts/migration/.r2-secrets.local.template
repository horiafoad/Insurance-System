# Cloudflare R2 credentials - for the one-off recovery upload only.
#
# Copy this file to  .r2-secrets.local  and fill in the four values.
#   copy .r2-secrets.local.template .r2-secrets.local
#
# .r2-secrets.local is git-ignored and is never read by the app or committed.
# The same four values must ALSO be set as Supabase Edge Function secrets,
# otherwise the app can upload the files but cannot open them:
#   npx supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... ^
#     R2_SECRET_ACCESS_KEY=... R2_BUCKET_NAME=...
#
# Where each value comes from (Cloudflare Dashboard):
#   R2_ACCOUNT_ID        R2 -> Account Overview -> Account ID
#   R2_ACCESS_KEY_ID     R2 -> Manage R2 API Tokens -> Create API Token
#   R2_SECRET_ACCESS_KEY   same screen, shown once
#   R2_BUCKET_NAME       R2 -> the bucket you created, e.g. insurance-files
#
# The token needs Object Read & Write, scoped to that one bucket only.
# Do not grant Admin Read.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
