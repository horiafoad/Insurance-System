  request_year INTEGER,
  certificate_type VARCHAR(100),
  notes TEXT,
  detail_scores JSONB,
  status VARCHAR(30) DEFAULT 'ÃƒËœÃ‚Â¬ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â¯',
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

