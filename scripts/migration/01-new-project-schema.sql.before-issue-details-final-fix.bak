-- [REMOVED by build-new-schema] Supabase Storage bucket seed; the project uses Cloudflare R2 for files


drop policy if exists "fsa_upload_objects" on storage.objects;

create policy "fsa_upload_objects"
  on storage.objects for insert
  to anon, authenticated with check (bucket_id = 'faculty-salary-archive');

drop policy if exists "fsa_read_objects" on storage.objects;

create policy "fsa_read_objects"
  on storage.objects for select
  to public using (bucket_id = 'faculty-salary-archive');

drop policy if exists "fsa_update_objects" on storage.objects;

create policy "fsa_update_objects"
  on storage.objects for update
  to anon, authenticated
  using (bucket_id = 'faculty-salary-archive')
  with check (bucket_id = 'faculty-salary-archive');

drop policy if exists "fsa_delete_objects" on storage.objects;

create policy "fsa_delete_objects"
  on storage.objects for delete
  to anon, authenticated using (bucket_id = 'faculty-salary-archive');


-- ==== faculty_salary_archive.sql ====================================
alter table public.faculty_salary_pages enable row level security;

drop policy if exists "Allow authenticated users to read faculty salary pages" on public.faculty_salary_pages;

drop policy if exists "Allow authenticated users to insert faculty salary pages" on public.faculty_salary_pages;

drop policy if exists "Allow program users to read faculty salary pages" on public.faculty_salary_pages;

drop policy if exists "Allow program users to insert faculty salary pages" on public.faculty_salary_pages;

create policy "Allow program users to read faculty salary pages"
  on public.faculty_salary_pages for select
  to anon, authenticated using (true);

create policy "Allow program users to insert faculty salary pages"
  on public.faculty_salary_pages for insert
  to anon, authenticated with check (true);

-- [REMOVED by build-new-schema] Supabase Storage bucket seed; the project uses Cloudflare R2 for files


drop policy if exists "Allow authenticated users to upload faculty salary files" on storage.objects;

drop policy if exists "Allow public access to faculty salary files" on storage.objects;

drop policy if exists "Allow program users to upload faculty salary files" on storage.objects;

drop policy if exists "Allow program users to read faculty salary files" on storage.objects;

create policy "Allow program users to upload faculty salary files"
  on storage.objects for insert
  to anon, authenticated with check (bucket_id = 'faculty-salaries');

create policy "Allow program users to read faculty salary files"
  on storage.objects for select
  to public using (bucket_id = 'faculty-salaries');


