  page_count INTEGER NOT NULL DEFAULT 0,               -- Ã˜Â¹Ã˜Â¯Ã˜Â¯ Ã˜ÂµÃ™ÂÃ˜Â­Ã˜Â§Ã˜Âª Ã™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ˜Â´Ã˜Â®Ã˜Âµ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ™Å 
  order_count INTEGER NOT NULL DEFAULT 0,              -- Ã˜Â¹Ã˜Â¯Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã™â€žÃ™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ˜Â´Ã˜Â®Ã˜Âµ
  created_by TEXT,
