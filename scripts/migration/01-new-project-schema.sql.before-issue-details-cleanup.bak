  LIKE salary_requests INCLUDING ALL
);

-- from create_scanner_inbox.sql
-- ==============================================================================
-- Ã˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã‚Â«Ã˜ÂµÃ™â€ Ã˜Â¯Ã™Ë†Ã™â€š Ã˜Â§Ã˜Â³Ã˜ÂªÃ™â€šÃ˜Â¨Ã˜Â§Ã™â€ž Ã™â€¦Ã˜Â³Ã˜Â­Ã™Ë†Ã˜Â­Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â§Ã™â€ Ã˜Â±Ã‚Â»
-- (Ã™Ë†Ã˜Â³Ã™Å Ã˜Â· Ã˜Â¨Ã™Å Ã™â€  Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â§Ã™â€ Ã˜Â± Ã˜Â§Ã™â€žÃ™ÂÃ˜Â¹Ã™â€žÃ™Å  Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜Â¨Ã™Ë†Ã˜Â· Ã˜Â¨Ã˜Â¬Ã™â€¡Ã˜Â§Ã˜Â² Ã˜Â§Ã™â€žÃ™Æ’Ã™â€¦Ã˜Â¨Ã™Å Ã™Ë†Ã˜ÂªÃ˜Â± Ã™Ë†Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã™â€šÃ˜Â¹: Ã˜Â§Ã™â€žÃ™Ë†Ã˜Â±Ã™â€šÃ˜Â© Ã˜ÂªÃ™ÂÃ˜Â³Ã™Æ’Ã™Å½Ã™â€  Ã™â€¦Ã˜Â­Ã™â€žÃ™Å Ã™â€¹Ã˜Â§
--  Ã˜Â«Ã™â€¦ Ã™Å Ã˜Â±Ã™ÂÃ˜Â¹Ã™â€¡Ã˜Â§ Ã‚Â«Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â³Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã™â€žÃ™Å Ã‚Â» Ã™â€¡Ã™â€ Ã˜Â§Ã˜Å’ Ã™Ë†Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã™â€šÃ˜Â¹ Ã™Å Ã˜Â³Ã˜ÂªÃ™â€šÃ˜Â¨Ã™â€žÃ™â€¡Ã˜Â§ Ã™Ë†Ã™Å Ã˜Â±Ã˜Â¨Ã˜Â·Ã™â€¡Ã˜Â§ Ã˜Â¨Ã˜ÂµÃ˜Â§Ã˜Â­Ã˜Â¨ Ã˜Â§Ã™â€žÃ˜Â£Ã™â€¦Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã™Å )
--
-- Ã˜Â§Ã™â€ Ã˜Â³Ã˜Â® Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™Æ’Ã™Ë†Ã˜Â¯ Ã˜Â¨Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã™â€¦Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ˜ÂµÃ™â€šÃ™â€¡ Ã™ÂÃ™Å  Supabase -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run
-- Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©.
--
-- Ã™Å Ã™â€ Ã˜Â´Ã˜Â¦:
--   1. Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž public.scanner_inbox          (Ã™Æ’Ã™â€ž Ã˜ÂµÃ™Â = Ã™Ë†Ã˜Â±Ã™â€šÃ˜Â© Ã™â€¦Ã™â€¦Ã˜Â³Ã™Ë†Ã˜Â­Ã˜Â© Ã™Ë†Ã™Ë†Ã˜ÂµÃ™â€žÃ˜Âª Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â§Ã™â€ Ã˜Â±)
--   2. Ã˜Â¨Ã™Æ’Ã˜Âª Ã˜ÂªÃ˜Â®Ã˜Â²Ã™Å Ã™â€  Ã˜Â¹Ã˜Â§Ã™â€¦ public "scanner-inbox"  (Ã™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜Â­Ã™Ë†Ã˜Â­Ã˜Â§Ã˜Âª)
--   3. Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª RLS Ã™â€žÃ™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ˜Â¨Ã™Æ’Ã˜Âª (Ã™â€šÃ˜Â±Ã˜Â§Ã˜Â¡Ã˜Â©/Ã˜Â¥Ã˜Â¯Ã˜Â±Ã˜Â§Ã˜Â¬/Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â«) Ã™â€žÃ™â€žÃ˜Â£Ã™â€ Ã™Ë†Ã™â€  Ã™Ë†Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦
-- ==============================================================================

-- 1. Ã˜ÂµÃ™â€ Ã˜Â¯Ã™Ë†Ã™â€š Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ™â€šÃ˜Â¨Ã˜Â§Ã™â€ž (Ã™Æ’Ã™â€ž Ã˜ÂµÃ™Â = Ã™â€¦Ã™â€žÃ™Â Ã™â€¦Ã˜Â³Ã™â€¦Ã™Ë†Ã˜Â­ Ã™Ë†Ã˜ÂµÃ™â€ž Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â§Ã™â€ Ã˜Â± Ã˜Â¹Ã˜Â¨Ã˜Â± Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â³Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã™â€žÃ™Å )
CREATE TABLE IF NOT EXISTS public.scanner_inbox (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  file_path TEXT NOT NULL,                            -- Ã™â€¦Ã˜Â³Ã˜Â§Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¨Ã™Æ’Ã˜Âª (Ã™â€¦Ã˜Â«Ã˜Â§Ã™â€ž: 1728....pdf)
  file_url TEXT,                                      -- Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â§Ã˜Â¨Ã˜Â· Ã˜Â§Ã™â€žÃ˜Â¹Ã˜Â§Ã™â€¦ Ã™â€žÃ™â€žÃ™â€¦Ã™â€žÃ™Â
  file_name TEXT,                                     -- Ã˜Â§Ã˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ˜Â£Ã˜ÂµÃ™â€žÃ™Å  (Ã™â€¦Ã˜Â«Ã˜Â§Ã™â€ž: Scan0001.pdf)
  file_mime TEXT,                                     -- image/jpeg Ã˜Â£Ã™Ë† application/pdf
  file_size BIGINT,                                   -- Ã˜Â­Ã˜Â¬Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â¨Ã˜Â§Ã™â€žÃ˜Â¨Ã˜Â§Ã™Å Ã˜Âª
  status TEXT NOT NULL DEFAULT 'pending',             -- pending = Ã˜Â¨Ã˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â± Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ™â€šÃ˜Â¨Ã˜Â§Ã™â€ž / done = Ã˜Â£Ã™ÂÃ˜Â¶Ã™Å Ã™Â Ã™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â±
  scanned_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),      -- Ã™Ë†Ã™â€šÃ˜Âª Ã™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜Â­Ã™Ë†Ã˜Â¨Ã˜Â© Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â§Ã™â€ Ã˜Â±
  processed_at TIMESTAMPTZ,                           -- Ã™Ë†Ã™â€šÃ˜Âª Ã˜Â±Ã˜Â¨Ã˜Â·Ã™â€¡Ã˜Â§ Ã˜Â¨Ã˜Â£Ã™â€¦Ã˜Â± Ã˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã™Å 
  processed_by TEXT,                                  -- Ã™â€¦Ã™â€  Ã˜Â§Ã˜Â³Ã˜ÂªÃ™â€šÃ˜Â¨Ã™â€žÃ™â€¡Ã˜Â§
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- from fix_database_and_rls.sql
-- 2. Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â·Ã™â€žÃ˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™Ë†Ã˜Â§Ã˜Â±Ã˜Â¯Ã˜Â© (Ã™â€¦Ã™ÂÃ˜Â±Ã˜Â¯Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜ÂªÃ˜Â¨ Ã™Ë†Ã˜ÂºÃ™Å Ã˜Â±Ã™â€¡Ã˜Â§)
CREATE TABLE IF NOT EXISTS public.service_requests (
