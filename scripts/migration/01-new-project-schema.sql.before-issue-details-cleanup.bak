-- ---------------------------------------------------------------------------
-- 4) R2 columns Ã¢â‚¬â€ Ã˜ÂªÃ˜Â­Ã™â€šÃ™â€š Ã™ÂÃ™â€šÃ˜Â· (Ã™â€žÃ˜Â§ Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã™â€¦Ã˜Â²Ã˜Â¯Ã™Ë†Ã˜Â¬Ã˜Â©)
--    storage_provider / storage_key Ã˜ÂªÃ™ÂÃ˜Â¶Ã˜Â§Ã™Â Ã˜Â±Ã˜Â³Ã™â€¦Ã™Å Ã™â€¹Ã˜Â§ Ã˜Â¹Ã˜Â¨Ã˜Â±
--    add_r2_storage_columns.sql (Ã˜Â­Ã™â€žÃ™â€šÃ˜Â© PL/pgSQL) Ã¢â‚¬â€ Ã™Ë†Ã™â€¡Ã™Ë† Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂµÃ˜Â¯Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¹Ã˜ÂªÃ™â€¦Ã˜Â¯.
--    Ã™â€¡Ã™â€ Ã˜Â§ Ã™â€ Ã˜ÂªÃ˜Â­Ã™â€šÃ™â€š Ã™ÂÃ™â€šÃ˜Â· Ã™Ë†Ã™â€ Ã˜Â¶Ã™Å Ã™Â Ã˜Â§Ã™â€žÃ™â€ Ã˜Â§Ã™â€šÃ˜Âµ Ã˜Â¥Ã™â€  Ã™Æ’Ã˜Â§Ã™â€  Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™ÂÃ™Å Ã™â€  Ã™â€žÃ™â€¦ Ã™Å Ã™ÂÃ™â€ Ã™ÂÃ™Å½Ã™â€˜Ã˜Â°Ã˜Â§Ã˜Å’ Ã˜Â­Ã˜ÂªÃ™â€° Ã™â€žÃ˜Â§ Ã™Å Ã˜Â¨Ã™â€šÃ™â€°
--    Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã™â€¦Ã™ÂÃ™â€šÃ™Ë†Ã˜Â¯ Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â®Ã˜Â·Ã˜Â£ Ã˜ÂµÃ˜Â§Ã™â€¦Ã˜Âª.
-- ---------------------------------------------------------------------------
do $$
declare
  t text;
begin
  foreach t in array array[
    'faculty_salary_pages','faculty_salary_archive','faculty_salary_imports',
    'employee_salary_archive','employee_salary_imports','salary_import_files',
    'issues','issue_details','case_documents','letters',
    'executive_order_persons','scanner_inbox'
  ] loop
    if not exists (
      select 1 from information_schema.columns
      where table_schema = 'public' and table_name = t
        and column_name = 'storage_provider'
    ) then
      execute format('alter table public.%I add column if not exists storage_provider text', t);
    end if;

    if not exists (
      select 1 from information_schema.columns
      where table_schema = 'public' and table_name = t
        and column_name = 'storage_key'
    ) then
      execute format('alter table public.%I add column if not exists storage_key text', t);
    end if;
  end loop;
end $$;

