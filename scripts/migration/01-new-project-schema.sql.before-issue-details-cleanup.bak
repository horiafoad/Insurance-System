-- add_scanner_r2_columns.sql
--
-- Ã™â€žÃ™â€¦Ã˜Â§Ã˜Â°Ã˜Â§ Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã™â€¦Ã™â€ Ã™ÂÃ˜ÂµÃ™â€ž Ã˜Â¹Ã™â€  add_r2_storage_columns.sqlÃ˜Å¸
--   Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â³Ã˜Â± Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ (scanner-bridge) Ã˜ÂµÃ˜Â§Ã˜Â± Ã™Å Ã˜Â±Ã™ÂÃ˜Â¹ Ã˜Â¥Ã™â€žÃ™â€° Cloudflare R2 Ã˜Â¹Ã˜Â¨Ã˜Â± Ã˜Â¯Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â­Ã˜Â§Ã™ÂÃ˜Â©
--   scanner-uploadÃ˜Å’ Ã™ÂÃ˜ÂµÃ˜Â§Ã˜Â± Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž scanner_inbox Ã™Å Ã˜Â­Ã˜ÂªÃ˜Â§Ã˜Â¬:
--     1) storage_provider / storage_key  Ã¢â€ Â Ã™Å Ã˜Â¹Ã˜ÂªÃ™â€¦Ã˜Â¯ Ã˜Â¹Ã™â€žÃ™â€° add_r2_storage_columns.sql
--        (Ã™â€ Ã™ÂÃ˜Â³ Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â¹Ã™â€¦Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦Ã˜Â© Ã™ÂÃ™Å  Ã˜Â¨Ã˜Â§Ã™â€šÃ™Å  Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹)
--     2) source_fingerprint  Ã¢â€ Â Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ Ã˜Â®Ã˜Â§Ã˜Âµ Ã˜Â¨Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜Â­Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Âª Ã™â€žÃ™â€¦Ã™â€ Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜ÂªÃ™Æ’Ã˜Â±Ã˜Â§Ã˜Â±
--
--   Ã˜Â£Ã™ÂÃ™ÂÃ˜Â±Ã˜Â¯Ã˜Âª Ã™ÂÃ™Å  Ã™â€¦Ã™â€žÃ™Â Ã™â€¦Ã™â€ Ã™ÂÃ˜ÂµÃ™â€ž Ã™â€žÃ˜Â£Ã™â€  (2) Ã˜ÂªÃ˜ÂºÃ™Å Ã™Å Ã˜Â± Ã˜Â®Ã˜Â§Ã˜Âµ Ã˜Â¨Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯ Ã™ÂÃ™â€šÃ˜Â·Ã˜Å’ Ã™Ë†Ã™â€žÃ˜Â£Ã™â€ 
--   add_r2_storage_columns.sql Ã™Å Ã™ÂÃ˜Â·Ã˜Â¨Ã™Å½Ã™â€˜Ã™â€š Ã˜Â¹Ã™â€žÃ™â€° 12 Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€žÃ™â€¹Ã˜Â§ Ã™Ë†Ã™Å Ã™ÂÃ™â€ Ã™ÂÃ™Å½Ã™â€˜Ã˜Â° Ã™â€šÃ˜Â¨Ã™â€ž Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â.
--
-- Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž: Supabase Dashboard -> SQL Editor -> New query -> Run
--
-- Ã¢Å¡Â Ã¯Â¸Â Ã˜Â¢Ã™â€¦Ã™â€  Ã˜ÂªÃ™â€¦Ã˜Â§Ã™â€¦Ã™â€¹Ã˜Â§:
--   Ã¢â‚¬Â¢ Ã™Æ’Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™â€žÃ™Å Ã˜Â§Ã˜Âª ADD COLUMN IF NOT EXISTS Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã™Å Ã™ÂÃ˜Â­Ã˜Â°Ã™Â Ã˜Â´Ã™Å Ã˜Â¡ Ã™Ë†Ã™â€žÃ˜Â§ Ã™Å Ã™ÂÃ˜Â¹Ã˜Â¯Ã™Å½Ã™â€˜Ã™â€ž Ã˜ÂµÃ™Â Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯
--   Ã¢â‚¬Â¢ Ã˜Â§Ã™â€žÃ˜ÂµÃ™ÂÃ™Ë†Ã™Â Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© (file_url Ã˜Â±Ã™Ë†Ã˜Â§Ã˜Â¨Ã˜Â· http) Ã˜ÂªÃ˜Â¨Ã™â€šÃ™â€° Ã™Æ’Ã™â€¦Ã˜Â§ Ã™â€¡Ã™Å  Ã™Ë†Ã˜ÂªÃ™ÂÃ™â€šÃ˜Â±Ã˜Â£ Ã™â€¦Ã™â€  Supabase
--   Ã¢â‚¬Â¢ unique index Ã˜Â¬Ã˜Â²Ã˜Â¦Ã™Å  Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ Ã™ÂÃ™â€šÃ˜Â·Ã˜Å’ Ã™ÂÃ˜Â§Ã™â€žÃ˜ÂµÃ™ÂÃ™Ë†Ã™Â Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© NULL Ã™â€žÃ˜Â§ Ã˜ÂªÃ˜ÂªÃ˜Â£Ã˜Â«Ã˜Â±
--   Ã¢â‚¬Â¢ Ã˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž Ã˜Â¢Ã™â€¦Ã™â€ Ã˜Â© (idempotent)
-- =============================================================================

-- 1) Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â£Ã™Æ’Ã˜Â¯ Ã™â€¦Ã™â€  Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž scanner_inbox (Ã™â€žÃ˜Â§ Ã™â€ Ã™â€ Ã˜Â´Ã˜Â¦Ã™â€¡ Ã™â€¡Ã™â€ Ã˜Â§ Ã¢â‚¬â€ Ã˜Â£Ã™â€ Ã˜Â´Ã˜Â£Ã™â€¡ create_scanner_inbox.sql)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.tables
    WHERE table_schema = 'public' AND table_name = 'scanner_inbox'
  ) THEN
    RAISE EXCEPTION 'Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž public.scanner_inbox Ã˜ÂºÃ™Å Ã˜Â± Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã¢â‚¬â€ Ã™â€ Ã™ÂÃ™â€˜Ã˜Â° create_scanner_inbox.sql Ã˜Â£Ã™Ë†Ã™â€žÃ™â€¹Ã˜Â§.';
  END IF;
END $$;

-- Ã˜Â§Ã™â€žÃ˜ÂµÃ™ÂÃ™Ë†Ã™Â Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© supabase Ã˜Â¯Ã˜Â§Ã˜Â¦Ã™â€¦Ã™â€¹Ã˜Â§Ã˜â€º Ã™â€žÃ˜Â§ Ã™â€ Ã˜Â¹Ã˜ÂªÃ™â€¦Ã˜Â¯ Ã˜Â¹Ã™â€žÃ™â€° NULL Ã™â€žÃ˜Â£Ã™â€ Ã™â€¡ Ã™â€šÃ˜Â¯ Ã™Å Ã˜Â¹Ã™â€ Ã™Å  "Ã˜ÂºÃ™Å Ã˜Â± Ã™â€¦Ã˜Â¹Ã˜Â±Ã™Ë†Ã™Â"
UPDATE public.scanner_inbox
   SET storage_provider = 'supabase'
 WHERE storage_provider IS NULL;

-- Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã™â€¦Ã™Ë†Ã˜Â­Ã˜Â© Ã¢â‚¬â€ Ã™ÂÃ™â€šÃ˜Â· 'supabase' Ã˜Â£Ã™Ë† 'r2'
ALTER TABLE public.scanner_inbox
  DROP CONSTRAINT IF EXISTS chk_scanner_inbox_storage_provider;

CREATE UNIQUE INDEX IF NOT EXISTS idx_scanner_inbox_fingerprint
  ON public.scanner_inbox (source_fingerprint)
  WHERE source_fingerprint IS NOT NULL;

-- 4) Ã™ÂÃ™â€¡Ã˜Â±Ã˜Â³ Ã™â€¦Ã˜Â³Ã˜Â§Ã˜Â¹Ã˜Â¯ Ã™â€žÃ™â€žÃ˜Â¬Ã˜Â±Ã˜Â¯: Ã˜Â¢Ã˜Â®Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜Â­Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Âª Ã™â€žÃ™Æ’Ã™â€ž Ã˜Â¨Ã™Æ’Ã˜Âª Ã™â€¦Ã™â€ Ã˜Â·Ã™â€šÃ™Å 
CREATE INDEX IF NOT EXISTS idx_scanner_inbox_storage_key
  ON public.scanner_inbox (storage_key)
  WHERE storage_key IS NOT NULL;

-- 5) Ã˜ÂªÃ˜Â­Ã™â€šÃ™â€˜Ã™â€š: Ã™Å Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã™â€¦Ã˜Â§ Ã˜ÂªÃ™â€¦Ã™â€˜Ã˜Âª Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜ÂªÃ™â€¡
SELECT column_name, data_type, is_nullable
  FROM information_schema.columns
 WHERE table_schema = 'public'
   AND table_name = 'scanner_inbox'
   AND column_name IN ('storage_provider', 'storage_key', 'source_fingerprint')
 ORDER BY column_name;

-- Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™Æ’Ã˜Â§Ã˜Â´ PostgREST Ã˜Â­Ã˜ÂªÃ™â€° Ã˜ÂªÃ˜Â¹Ã™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã˜Â§Ã˜Â¬Ã™â€¡Ã˜Â© Ã˜ÂªÃ˜Â­Ã™â€¦Ã™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â®Ã˜Â·Ã˜Â·
NOTIFY pgrst, 'reload schema';


