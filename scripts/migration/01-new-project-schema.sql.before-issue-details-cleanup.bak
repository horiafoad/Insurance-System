  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- from create_letters_tables.sql
-- ==============================================================================
-- Ã˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª Ã™Ë†Ã˜ÂªÃ˜ÂªÃ˜Â¨Ã˜Â¹ QR
-- Ã˜Â§Ã™â€ Ã˜Â³Ã˜Â® Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™Æ’Ã™Ë†Ã˜Â¯ Ã˜Â¨Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã™â€¦Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ˜ÂµÃ™â€šÃ™â€¡ Ã™ÂÃ™Å  Supabase -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run
-- Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©.
-- ==============================================================================

-- 1. Ã˜Â¥Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã˜ÂªÃ™Ë†Ã˜Â²Ã™Å Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª
CREATE TABLE IF NOT EXISTS public.letter_departments (
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(100) NOT NULL UNIQUE,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_letters_tables.sql
-- 2. Ã˜Â§Ã™â€žÃ˜Â¬Ã™â€¡Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜Â³Ã™â€žÃ˜Â© Ã™â€žÃ™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª
CREATE TABLE IF NOT EXISTS public.letter_senders (
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(150) NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_letters_tables.sql
-- 4. Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª
CREATE TABLE IF NOT EXISTS public.letters (
  id BIGSERIAL PRIMARY KEY,
  qr_code_id BIGINT REFERENCES public.archive_qr_codes(id),
  letter_number VARCHAR(100),
  letter_date DATE,
  sender_id BIGINT REFERENCES public.letter_senders(id),
  subject TEXT,
  status VARCHAR(30) DEFAULT 'in_progress'
    CHECK (status IN ('incoming', 'in_progress', 'needs_revision', 'completed', 'archived')),
  notes TEXT,
  image_url TEXT,
  letter_type VARCHAR(50),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_letters_tables.sql
-- 5. Ã˜Â­Ã˜Â±Ã™Æ’Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ Ã˜Â¨Ã™Å Ã™â€  Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª (Ã™Æ’Ã™â€ž Ã™â€¦Ã˜Â­Ã˜Â·Ã˜Â© = Ã˜ÂµÃ™Â)
CREATE TABLE IF NOT EXISTS public.letter_movements (
  id BIGSERIAL PRIMARY KEY,
  letter_id BIGINT REFERENCES public.letters(id) ON DELETE CASCADE,
  department_id BIGINT REFERENCES public.letter_departments(id),
  step_order INTEGER NOT NULL DEFAULT 0,
  received_at TIMESTAMP WITH TIME ZONE,
  sent_at TIMESTAMP WITH TIME ZONE,
  action TEXT,
  notes TEXT,
  status VARCHAR(30) DEFAULT 'waiting'
    CHECK (status IN ('in_progress', 'waiting', 'completed', 'needs_revision')),
  received_by VARCHAR(100),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_letter_templates_and_numbering.sql
-- 2) Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¹Ã˜Â¯Ã™â€˜Ã˜Â§Ã˜Â¯: Ã˜ÂµÃ™Â Ã™Ë†Ã˜Â­Ã™Å Ã˜Â¯ (id = 1) Ã™Å Ã˜Â¶Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜Â³Ã™â€žÃ˜Â³Ã™â€ž Ã˜Â§Ã™â€žÃ™ÂÃ˜Â±Ã™Å Ã˜Â¯
CREATE TABLE IF NOT EXISTS public.letter_number_counter (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  last_number BIGINT NOT NULL DEFAULT 0
);

-- from create_letter_sectors.sql
-- ==============================================================================
-- Ã˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â§Ã™â€žÃ™â€šÃ˜Â·Ã˜Â§Ã˜Â¹Ã˜Â§Ã˜Âª (Ã˜Â§Ã™â€žÃ™Æ’Ã™â€žÃ™Å Ã˜Â§Ã˜Âª) Ã™Ë†Ã˜Â±Ã˜Â¨Ã˜Â· Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã˜Â¨Ã™â€¡Ã˜Â§
-- Ã˜Â§Ã™â€ Ã˜Â³Ã˜Â® Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™Æ’Ã™Ë†Ã˜Â¯ Ã˜Â¨Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã™â€¦Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ˜ÂµÃ™â€šÃ™â€¡ Ã™ÂÃ™Å  Supabase -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run
-- Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©.
-- ==============================================================================

-- 1. Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â·Ã˜Â§Ã˜Â¹Ã˜Â§Ã˜Âª (Ã˜Â§Ã™â€žÃ™Æ’Ã™â€žÃ™Å Ã˜Â§Ã˜Âª)
CREATE TABLE IF NOT EXISTS public.letter_sectors (
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(100) NOT NULL UNIQUE,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_letter_templates_and_numbering.sql
-- =============================================================================
-- Ã™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ Ã™â€šÃ™Ë†Ã˜Â§Ã™â€žÃ˜Â¨ Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª + Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€žÃ™â€šÃ˜Â§Ã˜Â¦Ã™Å  Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜Â³Ã™â€žÃ˜Â³Ã™â€ž
-- Ã˜Â¢Ã™â€¦Ã™â€  Ã™Ë†Ã™â€šÃ˜Â§Ã˜Â¨Ã™â€ž Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (Idempotent) - Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©
-- Ã˜Â´Ã˜ÂºÃ™â€˜Ã™â€žÃ™â€¡ Ã™â€¦Ã˜Â±Ã˜Â© Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯Ã˜Â© Ã™ÂÃ™Å  Supabase SQL Editor
-- =============================================================================

-- 1) Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ™Ë†Ã˜Â§Ã™â€žÃ˜Â¨ (Template): Ã˜Â§Ã™â€žÃ™â€ Ã˜Âµ Ã˜Â§Ã™â€žÃ˜Â«Ã˜Â§Ã˜Â¨Ã˜Âª + Ã˜Â§Ã™â€žÃ˜Â­Ã™â€šÃ™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜ÂºÃ™Å Ã˜Â±Ã˜Â© + Ã˜Â§Ã™â€žÃ˜ÂªÃ˜ÂµÃ™â€ Ã™Å Ã™Â
CREATE TABLE IF NOT EXISTS public.letter_templates (
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(150) NOT NULL,
  letter_type VARCHAR(100) NOT NULL DEFAULT '',
  department_name VARCHAR(150) NOT NULL DEFAULT '',
  title TEXT NOT NULL DEFAULT '',
  fixed_text TEXT NOT NULL DEFAULT '',
  variable_fields JSONB NOT NULL DEFAULT '[]'::jsonb,
  default_route JSONB NOT NULL DEFAULT '[]'::jsonb,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_notifications_table.sql
-- ==============================================================================
-- Ã™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ (Ã˜Â¬Ã˜Â±Ã˜Â³ Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª) + Web Push
-- Ã™Å Ã™ÂÃ™â€ Ã™ÂÃ˜Â° Ã™â€¦Ã™â€  Supabase Dashboard -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run
-- Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©.
-- ==============================================================================

-- 1. Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª (Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂµÃ˜Â¯Ã˜Â± Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â³Ã˜Â§Ã˜Â³Ã™Å  Ã™â€žÃ˜Â¬Ã˜Â±Ã˜Â³ Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã™Ë†Ã˜Â§Ã™â€žÃ˜Â¹Ã˜Â¯Ã˜Â§Ã˜Â¯ Ã˜ÂºÃ™Å Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™â€šÃ˜Â±Ã™Ë†Ã˜Â¡)
CREATE TABLE IF NOT EXISTS public.notifications (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  user_id UUID NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
  type VARCHAR(50) NOT NULL DEFAULT 'general',
  title TEXT NOT NULL,
  body TEXT,
  reference_id TEXT,
  data JSONB,
  is_read BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_performance_and_courses_tables.sql
-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜ÂªÃ™â€šÃ™Å Ã™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â¯Ã˜Â§Ã˜Â¡ Ã™Ë†Ã˜Â§Ã™â€žÃ˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©
CREATE TABLE IF NOT EXISTS performance_evaluations (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  employee_id INTEGER,
  evaluation_month VARCHAR(20) NOT NULL,
  evaluation_year INTEGER NOT NULL,
  completion_rate DECIMAL(5,2) DEFAULT 0,
  on_time_rate DECIMAL(5,2) DEFAULT 0,
  accuracy_rate DECIMAL(5,2) DEFAULT 0,
  speed_rate DECIMAL(5,2) DEFAULT 0,
  review_rate DECIMAL(5,2) DEFAULT 0,
  upload_rate DECIMAL(5,2) DEFAULT 0,
  organization_rate DECIMAL(5,2) DEFAULT 0,
  total_score DECIMAL(5,2) DEFAULT 0,
  grade VARCHAR(20) DEFAULT 'Ã™Å Ã˜Â­Ã˜ÂªÃ˜Â§Ã˜Â¬ Ã˜ÂªÃ˜Â­Ã˜Â³Ã™Å Ã™â€ ',
  notes TEXT,
  detail_scores JSONB,
  evaluator_id UUID REFERENCES users(id),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_public_feedback_table.sql
-- ==============================================================================
-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã™Ë†Ã˜Â¥Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­ Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜ÂªÃ™â€šÃ™Å Ã™Å Ã™â€¦Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â¯Ã™â€¦Ã˜Â© Ã™Ë†Ã˜Â§Ã™â€žÃ˜Â´Ã™Æ’Ã˜Â§Ã™Ë†Ã™â€° Ã˜Â§Ã™â€žÃ™â€šÃ˜Â§Ã˜Â¯Ã™â€¦Ã˜Â© Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜ÂµÃ™ÂÃ˜Â­Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¦Ã™Å Ã˜Â³Ã™Å Ã˜Â©
-- ==============================================================================
CREATE TABLE IF NOT EXISTS public.public_feedback (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  feedback_type VARCHAR(50) NOT NULL,
  name VARCHAR(150) NOT NULL,
  phone VARCHAR(50),
  rating INTEGER,
  message TEXT,
  source_page VARCHAR(50) DEFAULT 'Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¦Ã™Å Ã˜Â³Ã™Å Ã˜Â©',
  status VARCHAR(30) DEFAULT 'Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯',
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_push_subscriptions.sql
-- ==============================================================================
-- Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¨Ã˜Â§Ã™Å Ã™â€ž (Web Push)
-- Ã™Å Ã™ÂÃ™â€ Ã™ÂÃ˜Â° Ã™â€¦Ã™â€  Supabase Dashboard -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run
-- Ã™â€¦Ã™â€žÃ˜Â§Ã˜Â­Ã˜Â¸Ã˜Â©: Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã™â€žÃ˜Â§ Ã™Å Ã™ÂÃ˜Â·Ã˜Â¨Ã™â€˜Ã™â€š Ã˜ÂªÃ™â€žÃ™â€šÃ˜Â§Ã˜Â¦Ã™Å Ã˜Â§Ã™â€¹ Ã˜Â£Ã˜Â«Ã™â€ Ã˜Â§Ã˜Â¡ Ã˜Â§Ã™â€žÃ˜Â¨Ã™â€ Ã˜Â§Ã˜Â¡.
-- ==============================================================================

-- 1. Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã˜Â´Ã˜ÂªÃ˜Â±Ã˜Â§Ã™Æ’Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â¬Ã™â€¡Ã˜Â²Ã˜Â© (Device Subscriptions)
CREATE TABLE IF NOT EXISTS public.push_subscriptions (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  user_id UUID NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
