CREATE INDEX IF NOT EXISTS idx_issue_details_issue_id ON issue_details(issue_id);

-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â¯Ã˜Â§Ã™â€žÃ˜Â© Ã™â€žÃ˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« updated_at Ã˜ÂªÃ™â€žÃ™â€šÃ˜Â§Ã˜Â¦Ã™Å Ã˜Â§Ã™â€¹
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$ language 'plpgsql';

-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã™Å Ã˜Â¬Ã˜Â± Ã™â€žÃ˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« updated_at
CREATE TRIGGER update_issues_updated_at 
  BEFORE UPDATE ON issues 
  FOR EACH ROW 
  EXECUTE FUNCTION update_updated_at_column();

-- Ã˜ÂªÃ™ÂÃ˜Â¹Ã™Å Ã™â€ž Row Level Security (RLS)
ALTER TABLE issues ENABLE ROW LEVEL SECURITY;

ALTER TABLE issue_details ENABLE ROW LEVEL SECURITY;

-- Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã™â€žÃ™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§
-- Old duplicate issues policies removed; final issues policies are defined later.

-- Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã™â€žÃ˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§
CREATE POLICY "Ã™Å Ã™â€¦Ã™Æ’Ã™â€  Ã™â€žÃ™â€žÃ˜Â¬Ã™â€¦Ã™Å Ã˜Â¹ Ã™â€šÃ˜Â±Ã˜Â§Ã˜Â¡Ã˜Â© Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§" ON issue_details
  FOR SELECT USING (true);

CREATE POLICY "Ã™Å Ã™â€¦Ã™Æ’Ã™â€  Ã™â€žÃ™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦Ã™Å Ã™â€  Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂµÃ˜Â§Ã˜Â¯Ã™â€šÃ™Å Ã™â€  Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§" ON issue_details
  FOR INSERT WITH CHECK (true);

CREATE POLICY "Ã™Å Ã™â€¦Ã™Æ’Ã™â€  Ã™â€žÃ™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦Ã™Å Ã™â€  Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂµÃ˜Â§Ã˜Â¯Ã™â€šÃ™Å Ã™â€  Ã˜Â­Ã˜Â°Ã™Â Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§" ON issue_details
  FOR DELETE USING (true);

-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜ÂªÃ˜Â¹Ã™â€žÃ™Å Ã™â€šÃ˜Â§Ã˜Âª Ã™â€žÃ™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž
COMMENT ON TABLE issues IS 'Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§ Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¦Ã™Å Ã˜Â³Ã™Å ';

COMMENT ON TABLE issue_details IS 'Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ™Ë†Ã˜Â±Ã˜Â¯Ã˜Â© Ã™â€¦Ã™â€  Excel';

COMMENT ON COLUMN issues.case_number IS 'Ã˜Â±Ã™â€šÃ™â€¦ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã™Å Ã˜Â© Ã˜Â§Ã™â€žÃ™ÂÃ˜Â±Ã™Å Ã˜Â¯';

COMMENT ON COLUMN issues.case_type IS 'Ã™â€ Ã™Ë†Ã˜Â¹ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã™Å Ã˜Â©: Ã™ÂÃ˜Â±Ã˜Â¯Ã™Å Ã˜Â© Ã˜Â£Ã™Ë† Ã˜Â¬Ã™â€¦Ã˜Â§Ã˜Â¹Ã™Å Ã˜Â©';

COMMENT ON COLUMN issues.file_type IS 'Ã™â€ Ã™Ë†Ã˜Â¹ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â: Excel Ã˜Â£Ã™Ë† PDF';

COMMENT ON COLUMN issues.status IS 'Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã™Å Ã˜Â©: Ã™â€¦Ã˜Â¹Ã™â€žÃ™â€šÃ˜Â©Ã˜Å’ Ã™â€¦Ã™Ë†Ã˜Â§Ã™ÂÃ™â€šÃ˜Â©Ã˜Å’ Ã™â€¦Ã˜Â±Ã™ÂÃ™Ë†Ã˜Â¶Ã˜Â©Ã˜Å’ Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¹Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â©';


-- ==== update_issue_payment_statuses.sql ====================================
CREATE INDEX IF NOT EXISTS idx_case_documents_case_id ON case_documents(case_id);

-- 3) Ã˜ÂªÃ™Ë†Ã˜Â­Ã™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© Ã™â€žÃ™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ™Å Ã˜Â© (Ã˜Â§Ã™â€žÃ˜Â­Ã™ÂÃ˜Â§Ã˜Â¸ Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã™Ë†Ã˜Â¯Ã™â€¦Ã˜Â¬ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ˜ÂªÃ™Å Ã™â€ )
UPDATE issues
SET payment_status = 'Ã˜ÂªÃ™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â° Ã™Ë†Ã™ÂÃ™Å  Ã˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂµÃ˜Â±Ã™Â'
WHERE payment_status IN ('Ã˜ÂªÃ™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°', 'Ã™ÂÃ™Å  Ã˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂµÃ˜Â±Ã™Â');

-- 4) Ã˜Â¥Ã˜Â²Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦ (5 Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â§Ã˜Âª) Ã™Ë†Ã˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¦Ã™â€¡ Ã˜Â¨Ã˜Â§Ã™â€žÃ™â€ Ã˜Â·Ã˜Â§Ã™â€š Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ (4 Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â§Ã˜Âª)
ALTER TABLE issues DROP CONSTRAINT IF EXISTS issues_payment_status_check;

COMMENT ON COLUMN issues.payment_status IS
  'Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ˜ÂµÃ˜Â±Ã™Â: Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã˜Å’ Ã˜ÂªÃ™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â° Ã™Ë†Ã™ÂÃ™Å  Ã˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂµÃ˜Â±Ã™ÂÃ˜Å’ Ã˜ÂªÃ™â€¦ Ã˜Â§Ã™â€žÃ˜ÂµÃ˜Â±Ã™ÂÃ˜Å’ Ã™â€¦Ã˜Â±Ã™ÂÃ™Ë†Ã˜Â¶Ã˜Â©';

-- 5) Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª (Ã˜Â¢Ã™â€¦Ã™â€ Ã˜Â© Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°)
ALTER TABLE case_documents ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "cd_select" ON case_documents;

CREATE POLICY "cd_select" ON case_documents
  FOR SELECT USING (true);

DROP POLICY IF EXISTS "cd_insert" ON case_documents;

CREATE POLICY "cd_insert" ON case_documents
  FOR INSERT WITH CHECK (true);

DROP POLICY IF EXISTS "cd_update" ON case_documents;

CREATE POLICY "cd_update" ON case_documents
  FOR UPDATE USING (true);

DROP POLICY IF EXISTS "cd_delete" ON case_documents;

CREATE POLICY "cd_delete" ON case_documents
  FOR DELETE USING (true);

NOTIFY pgrst, 'reload schema';


-- ==== create_notifications_table.sql ====================================
-- 2. Ã™ÂÃ™â€¡Ã˜Â§Ã˜Â±Ã˜Â³ Ã™â€žÃ™â€žÃ˜Â¨Ã˜Â­Ã˜Â« Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â±Ã™Å Ã˜Â¹ (Ã˜Â¬Ã™â€žÃ˜Â¨ Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â±Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦ + Ã˜Â¹Ã˜Â¯Ã˜Â¯ Ã˜ÂºÃ™Å Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™â€šÃ˜Â±Ã™Ë†Ã˜Â¡)
CREATE INDEX IF NOT EXISTS idx_notifications_user_created
  ON public.notifications(user_id, created_at DESC);

CREATE INDEX IF NOT EXISTS idx_notifications_user_unread
  ON public.notifications(user_id, is_read);

-- 3. Ã˜Â§Ã™â€žÃ˜Â£Ã™â€¦Ã˜Â§Ã™â€ : Ã™â€ Ã™ÂÃ˜Â³ Ã™â€ Ã™â€¦Ã˜Â· Ã˜Â¨Ã™â€šÃ™Å Ã˜Â© Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ (RLS Ã™â€¦Ã˜Â¹Ã˜Â·Ã™â€˜Ã™â€ž Ã¢â‚¬â€ Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â®Ã™Ë†Ã™â€ž Ã™â€¦Ã˜Â®Ã˜ÂµÃ˜Âµ Ã™â€žÃ™â€žÃ™â€¦Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹)
ALTER TABLE public.notifications DISABLE ROW LEVEL SECURITY;

GRANT ALL ON TABLE public.notifications TO anon, authenticated, postgres, service_role;

-- ==============================================================================
-- 4. Ã™â€¦Ã˜Â­Ã™ÂÃ˜Â²: Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â± Ã™ÂÃ™Ë†Ã˜Â±Ã™Å  Ã˜Â¹Ã™â€ Ã˜Â¯ Ã™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã˜Â·Ã™â€žÃ˜Â¨ Ã˜Â¥Ã™â€žÃ™Æ’Ã˜ÂªÃ˜Â±Ã™Ë†Ã™â€ Ã™Å  Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ (service_requests)
--    Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ™â€žÃ™â€šÃ™Ë†Ã™â€ : Ã™Æ’Ã™â€ž Ã™â€¦Ã™â€  Ã™Å Ã™â€¦Ã™â€žÃ™Æ’ Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­Ã™Å Ã˜Â© "requests" Ã˜Â£Ã™Ë† Ã˜Â­Ã˜Â³Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª Ã™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© Ã˜Â¨Ã™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã™Æ’Ã˜Â§Ã™â€¦Ã™â€ž
--    Ã˜Â£Ã™Ë† Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â¯Ã™Ë†Ã˜Â§Ã˜Â± super_admin / admin (Ã™â€ Ã™ÂÃ˜Â³ Ã™â€¦Ã™â€ Ã˜Â·Ã™â€š push-notifications).
-- ==============================================================================
CREATE OR REPLACE FUNCTION public.create_request_notifications()
RETURNS TRIGGER AS $$
BEGIN
  INSERT INTO public.notifications (user_id, type, title, body, reference_id, data)
  SELECT
    u.id,
    'new_request',
    'Ã°Å¸â€â€ Ã˜Â·Ã™â€žÃ˜Â¨ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯',
    'Ã™Ë†Ã˜ÂµÃ™â€ž Ã˜Â·Ã™â€žÃ˜Â¨ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ Ã™Å Ã˜Â­Ã˜ÂªÃ˜Â§Ã˜Â¬ Ã˜Â¥Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â¹Ã˜Â©',
    NEW.id::text,
    jsonb_build_object(
      'request_id', NEW.id,
      'requester_name', NEW.name,
      'service_type', NEW.service_type,
      'status', NEW.status
    )
  FROM public.users u
  WHERE u.id IS NOT NULL
    AND (
      u.permissions IS NULL
      OR u.role IN ('super_admin', 'admin')
      OR (u.permissions IS NOT NULL AND u.permissions ? 'requests')
    )
    -- Ã™â€¦Ã™â€ Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜ÂªÃ™Æ’Ã˜Â±Ã˜Â§Ã˜Â±: Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â± Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯ Ã™ÂÃ™â€šÃ˜Â· Ã™â€žÃ™Æ’Ã™â€ž Ã™â€¦Ã˜Â²Ã™Å Ã˜Â¬ (type + reference_id + user_id)
    AND NOT EXISTS (
      SELECT 1
      FROM public.notifications n
      WHERE n.user_id = u.id
        AND n.type = 'new_request'
        AND n.reference_id = NEW.id::text
    );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

DROP TRIGGER IF EXISTS trg_create_request_notifications
  ON public.service_requests;

CREATE TRIGGER trg_create_request_notifications
  AFTER INSERT ON public.service_requests
  FOR EACH ROW
  EXECUTE FUNCTION public.create_request_notifications();

-- ==============================================================================
-- 5. Ã˜Â¯Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã™ÂÃ˜Â²: Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â± Ã™ÂÃ™Ë†Ã˜Â±Ã™Å  Ã˜Â¹Ã™â€ Ã˜Â¯ Ã™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ Ã˜Â¥Ã™â€žÃ™â€° Ã™â€šÃ˜Â³Ã™â€¦ (letter_movements)
--    Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ™â€žÃ™â€šÃ™Ë†Ã™â€ : Ã™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦Ã™Ë† Ã˜Â§Ã™â€žÃ™â€šÃ˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¡Ã˜Â¯Ã™Â Ã™ÂÃ™â€šÃ˜Â· + Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¯Ã˜Â±Ã˜Â§Ã˜Â¡ (super_admin / admin).
--    Ã™â€¦Ã™â€žÃ˜Â§Ã˜Â­Ã˜Â¸Ã˜Â©: Ã˜ÂªÃ™ÂÃ™â€ Ã˜Â´Ã˜Â£ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã™â€žÃ™â€° Ã˜Â¨Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â© in_progress Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â§Ã˜Â³Ã˜ÂªÃ™â€žÃ˜Â§Ã™â€¦ Ã˜Â¹Ã™â€ Ã˜Â¯ Ã˜ÂªÃ˜Â³Ã˜Â¬Ã™Å Ã™â€ž Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨
--    Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Å’ Ã™Ë†Ã™Æ’Ã˜Â°Ã™â€žÃ™Æ’ Ã˜Â¹Ã™â€ Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â³Ã™â€žÃ™Å Ã™â€¦ Ã™â€žÃ™â€žÃ™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â§Ã™â€žÃ™Å Ã˜Â© Ã¢â‚¬â€ Ã™ÂÃ™â€žÃ˜Â§ Ã™Å Ã˜ÂµÃ™â€žÃ™Æ’ Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â± Ã˜Â¥Ã™â€žÃ˜Â§ Ã™â€žÃ™â€žÃ™â€šÃ˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¹Ã™â€ Ã™Å .
-- ==============================================================================
CREATE OR REPLACE FUNCTION public.create_letter_notifications()
RETURNS TRIGGER AS $$
DECLARE
  dept_name TEXT;
  letter_subject TEXT;
  letter_no TEXT;
BEGIN
  SELECT
    d.name, l.subject, l.letter_number
    INTO dept_name, letter_subject, letter_no
  FROM public.letters l
  LEFT JOIN public.letter_departments d ON d.id = NEW.department_id
  WHERE l.id = NEW.letter_id
  LIMIT 1;

  INSERT INTO public.notifications (user_id, type, title, body, reference_id, data)
  SELECT
    u.id,
    'new_letter',
    'Ã°Å¸â€œÂ© Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯',
    'Ã™Ë†Ã˜ÂµÃ™â€ž Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ Ã˜Â¥Ã™â€žÃ™â€° Ã™â€šÃ˜Â³Ã™â€¦ ' || COALESCE(dept_name, ''),
    NEW.letter_id::text,
    jsonb_build_object(
      'letter_id', NEW.letter_id,
      'letter_number', letter_no,
      'subject', letter_subject,
      'department_id', NEW.department_id,
      'department_name', dept_name
    )
  FROM public.users u
  WHERE u.id IS NOT NULL
    AND (
      u.department_id = NEW.department_id
      OR u.role IN ('super_admin', 'admin')
    )
    -- Ã™â€¦Ã™â€ Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜ÂªÃ™Æ’Ã˜Â±Ã˜Â§Ã˜Â±: Ã˜Â¥Ã˜Â´Ã˜Â¹Ã˜Â§Ã˜Â± Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯ Ã™ÂÃ™â€šÃ˜Â· Ã™â€žÃ™Æ’Ã™â€ž Ã™â€¦Ã˜Â²Ã™Å Ã˜Â¬ (type + reference_id + user_id)
    AND NOT EXISTS (
      SELECT 1
      FROM public.notifications n
      WHERE n.user_id = u.id
        AND n.type = 'new_letter'
        AND n.reference_id = NEW.letter_id::text
    );

  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Ã˜Â¥Ã˜Â¯Ã˜Â±Ã˜Â§Ã˜Â¬ Ã™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â© (Ã˜ÂªÃ˜Â³Ã˜Â¬Ã™Å Ã™â€ž Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ -> Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã™â€žÃ™â€° in_progress Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â§Ã˜Â³Ã˜ÂªÃ™â€žÃ˜Â§Ã™â€¦)
DROP TRIGGER IF EXISTS trg_letter_notifications_insert
  ON public.letter_movements;

CREATE TRIGGER trg_letter_notifications_insert
  AFTER INSERT ON public.letter_movements
  FOR EACH ROW
  WHEN (
    NEW.status = 'in_progress'
    AND NEW.received_at IS NULL
    AND NEW.sent_at IS NULL
  )
  EXECUTE FUNCTION public.create_letter_notifications();

-- Ã˜ÂªÃ˜Â³Ã™â€žÃ™Å Ã™â€¦ Ã˜Â¥Ã™â€žÃ™â€° Ã™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â© (Ã˜ÂªÃ™â€ Ã˜ÂªÃ™â€šÃ™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â­Ã˜Â·Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â§Ã™â€žÃ™Å Ã˜Â© Ã˜Â¥Ã™â€žÃ™â€° in_progress Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â§Ã˜Â³Ã˜ÂªÃ™â€žÃ˜Â§Ã™â€¦)
DROP TRIGGER IF EXISTS trg_letter_notifications_update
  ON public.letter_movements;

CREATE TRIGGER trg_letter_notifications_update
  AFTER UPDATE OF status ON public.letter_movements
  FOR EACH ROW
  WHEN (
    NEW.status = 'in_progress'
    AND NEW.received_at IS NULL
    AND NEW.sent_at IS NULL
    AND OLD.status IS DISTINCT FROM 'in_progress'
  )
  EXECUTE FUNCTION public.create_letter_notifications();

-- ==============================================================================
-- 6. Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž notifications Ã˜Â¥Ã™â€žÃ™â€° Ã™â€ Ã˜Â´Ã˜Â± Realtime Ã™â€žÃ˜Â¬Ã˜Â¹Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¹Ã˜Â¯Ã˜Â§Ã˜Â¯ Ã™â€žÃ˜Â­Ã˜Â¸Ã™Å Ã™â€¹Ã˜Â§ Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Refresh
-- ==============================================================================
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_publication WHERE pubname = 'supabase_realtime') THEN
    CREATE PUBLICATION supabase_realtime;
  END IF;
END
$$;

DO $$
BEGIN
  IF to_regclass('public.notifications') IS NULL THEN
    RAISE NOTICE 'SKIP notifications (table does not exist)';
    RETURN;
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
     WHERE pubname = 'supabase_realtime'
       AND schemaname = 'public'
       AND tablename = 'notifications'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE public.notifications;
    RAISE NOTICE 'ADDED notifications TO supabase_realtime';
  ELSE
    RAISE NOTICE 'SKIP notifications (already published)';
  END IF;
END
$$;

-- Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™Æ’Ã˜Â§Ã˜Â´ PostgREST
NOTIFY pgrst, 'reload schema';


-- ==== create_push_subscriptions.sql ====================================
-- 2. Ã™ÂÃ™â€¡Ã˜Â±Ã˜Â³ Ã™â€žÃ˜Â³Ã˜Â±Ã˜Â¹Ã˜Â© Ã˜Â¬Ã™â€žÃ˜Â¨ Ã˜Â§Ã˜Â´Ã˜ÂªÃ˜Â±Ã˜Â§Ã™Æ’Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦
CREATE INDEX IF NOT EXISTS idx_push_subscriptions_user_id
  ON public.push_subscriptions(user_id);

-- 3. Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« updated_at Ã˜ÂªÃ™â€žÃ™â€šÃ˜Â§Ã˜Â¦Ã™Å Ã˜Â§Ã™â€¹
CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_push_subscriptions_updated_at
  ON public.push_subscriptions;

CREATE TRIGGER trg_push_subscriptions_updated_at
  BEFORE UPDATE ON public.push_subscriptions
  FOR EACH ROW
  EXECUTE FUNCTION public.set_updated_at();

-- 4. Ã˜Â§Ã™â€žÃ˜Â£Ã™â€¦Ã˜Â§Ã™â€ : RLS Ã™â€¦Ã™ÂÃ˜Â¹Ã™â€˜Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã™ÂÃ™â€šÃ˜Â· Ã˜Â¹Ã˜Â¨Ã˜Â± service_role (Edge Function)
--    Ã™â€žÃ˜Â£Ã™â€  Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦ supabase.authÃ˜Å’ Ã™Å Ã™ÂÃ™â€¦Ã™â€ Ã˜Â¹ Ã˜Â§Ã™â€žÃ™Ë†Ã˜ÂµÃ™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â± Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™Å Ã™â€ž Ã™Æ’Ã™â€žÃ™Å Ã˜Â§Ã™â€¹.
ALTER TABLE public.push_subscriptions ENABLE ROW LEVEL SECURITY;

REVOKE ALL ON TABLE public.push_subscriptions FROM anon, authenticated;

GRANT ALL ON TABLE public.push_subscriptions TO service_role;

GRANT ALL ON TABLE public.push_subscriptions TO postgres;


