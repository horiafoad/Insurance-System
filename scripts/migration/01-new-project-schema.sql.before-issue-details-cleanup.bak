-- ============================================
-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â¯Ã™Ë†Ã˜Â§Ã™â€ž Ã™â€žÃ™â€žÃ˜Â­Ã™ÂÃ˜Â§Ã˜Â¸ Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â£Ã˜Â¯Ã˜Â§Ã˜Â¡ Ã™â€šÃ˜Â§Ã˜Â¹Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª
-- ============================================

-- Ã˜Â¯Ã˜Â§Ã™â€žÃ˜Â© Ã™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™ÂÃ˜Â© Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© (Ã˜Â£Ã™Æ’Ã˜Â¨Ã˜Â± Ã™â€¦Ã™â€  Ã˜Â³Ã™â€ Ã˜Â©)
CREATE OR REPLACE FUNCTION archive_old_data()
RETURNS void AS $$
BEGIN
  -- Ã˜Â£Ã˜Â±Ã˜Â´Ã™ÂÃ˜Â© Ã˜ÂµÃ™ÂÃ˜Â­Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜ÂªÃ˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â©
  INSERT INTO faculty_salary_pages_archive
  SELECT * FROM faculty_salary_pages
  WHERE period_year < EXTRACT(YEAR FROM CURRENT_DATE) - 1
  ON CONFLICT DO NOTHING;
  
  DELETE FROM faculty_salary_pages
  WHERE period_year < EXTRACT(YEAR FROM CURRENT_DATE) - 1;
  
  -- Ã˜Â£Ã˜Â±Ã˜Â´Ã™ÂÃ˜Â© Ã˜Â·Ã™â€žÃ˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â¯Ã™â€¦Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â©
  INSERT INTO salary_requests_archive
  SELECT * FROM salary_requests
  WHERE request_year < EXTRACT(YEAR FROM CURRENT_DATE) - 1
  ON CONFLICT DO NOTHING;
  
  DELETE FROM salary_requests
  WHERE request_year < EXTRACT(YEAR FROM CURRENT_DATE) - 1;
  
  -- Ã™â€ Ã™ÂÃ˜Â³ Ã˜Â§Ã™â€žÃ˜Â´Ã™Å Ã˜Â¡ Ã™â€žÃ˜Â¨Ã˜Â§Ã™â€šÃ™Å  Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž
  INSERT INTO fellowship_requests_archive
  SELECT * FROM fellowship_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1
  ON CONFLICT DO NOTHING;
  
  DELETE FROM fellowship_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1;
  
  INSERT INTO welfare_requests_archive
  SELECT * FROM welfare_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1
  ON CONFLICT DO NOTHING;
  
  DELETE FROM welfare_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1;
  
  INSERT INTO certificate_requests_archive
  SELECT * FROM certificate_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1
  ON CONFLICT DO NOTHING;
  
  DELETE FROM certificate_requests
  WHERE EXTRACT(YEAR FROM request_date) < EXTRACT(YEAR FROM CURRENT_DATE) - 1;
END;
$$ LANGUAGE plpgsql;

-- ============================================
-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â¯Ã™Ë†Ã˜Â§Ã™â€ž Ã™â€žÃ˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â­Ã˜ÂµÃ˜Â§Ã˜Â¦Ã™Å Ã˜Â§Ã˜Âª Ã˜Â¨Ã˜Â´Ã™Æ’Ã™â€ž Ã™â€¦Ã˜ÂªÃ™â€šÃ˜Â·Ã˜Â¹
-- ============================================

