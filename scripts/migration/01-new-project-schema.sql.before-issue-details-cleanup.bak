-- ---------------------------------------------------------------
-- 1) Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¦Ã™Å Ã˜Â³Ã™Å  Ã™â€žÃ™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â
-- Ã˜Â±Ã˜Â¨Ã˜Â· Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â¨Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¸Ã™Â Ã™Å Ã˜ÂªÃ™â€¦ Ã˜Â¹Ã˜Â¨Ã˜Â± Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ computer_number
-- (Ã™â€¦Ã™ÂÃ˜ÂªÃ˜Â§Ã˜Â­ Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¨Ã˜Â·) + employee_nameÃ˜Å’ Ã˜Â¨Ã™Å Ã™â€ Ã™â€¦Ã˜Â§ Mirror Ã™â€žÃ™â€žÃ˜Â¨Ã™â€ Ã™Å Ã˜Â© Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Storage:
--   employee-salary-archive/employee-salaries/{computer_number}/{year}/{month}/{file}
-- ---------------------------------------------------------------
create table if not exists public.employee_salary_archive (
  id bigint generated by default as identity primary key,
  employee_name text not null,
  computer_number text not null,
  year integer not null,
  month integer not null check (month between 1 and 12),
  sequence integer not null default 1,
  file_url text not null,
  preview_url text,
  preview_urls text[] not null default '{}',
  page_count integer not null default 1,
  file_path text,
  original_filename text,
  created_by text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (computer_number, year, month, sequence)
);

