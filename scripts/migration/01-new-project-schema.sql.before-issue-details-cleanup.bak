-- ==== enable_executive_orders_delete.sql ====================================
-- ==============================================================================
-- Ã˜ÂªÃ™ÂÃ˜Â¹Ã™Å Ã™â€ž Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã™Å Ã˜Â© Ã™â€¦Ã™â€  Ã˜Â´Ã˜Â§Ã˜Â´Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€žÃ™Å Ã™â€¹Ã˜Â§
--
-- Ã™â€¦Ã™â€¡Ã™â€¦ Ã™â€žÃ™â€žÃ˜ÂºÃ˜Â§Ã™Å Ã˜Â©: Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã™â€žÃ˜Â§ Ã™Å Ã˜ÂºÃ™Å Ã™â€˜Ã˜Â± Ã˜Â£Ã™Å  Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã™Ë†Ã™â€žÃ˜Â§ Ã˜Â£Ã™Å  Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã™Ë†Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª.
-- Ã™Å Ã˜Â¶Ã™Å Ã™Â Ã™ÂÃ™â€šÃ˜Â· Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª DELETE (Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­Ã™Å Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â°Ã™Â) Ã™â€žÃ™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã™Ë†Ã™â€žÃ™â€žÃ™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â®Ã˜Â²Ã™â€ Ã˜Â© Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¨Ã™Æ’Ã˜ÂªÃ˜Å’
-- Ã™Ë†Ã™â€¡Ã™Å  Ã™â€¦Ã˜Â·Ã™â€žÃ™Ë†Ã˜Â¨Ã˜Â© Ã™â€žÃ™Æ’Ã™Å  Ã™Å Ã˜Â¹Ã™â€¦Ã™â€ž Ã˜Â²Ã˜Â± Ã‚Â«Ã˜Â­Ã˜Â°Ã™ÂÃ‚Â» Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â·Ã˜Â¨Ã™Å Ã™â€š Ã˜Â¹Ã˜Â¨Ã˜Â± Ã™â€¦Ã™ÂÃ˜ÂªÃ˜Â§Ã˜Â­ anon.
--
-- Ã˜Â§Ã™â€ Ã˜Â³Ã˜Â® Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™Æ’Ã™Ë†Ã˜Â¯ Ã˜Â¨Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã™â€¦Ã™â€ž Ã™Ë†Ã˜Â§Ã™â€žÃ˜ÂµÃ™â€šÃ™â€¡ Ã™ÂÃ™Å  Supabase -> SQL Editor Ã˜Â«Ã™â€¦ Ã˜Â§Ã˜Â¶Ã˜ÂºÃ˜Â· Run (Ã™â€¦Ã˜Â±Ã˜Â© Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯Ã˜Â© Ã™Æ’Ã˜Â§Ã™ÂÃ™Å Ã˜Â©).
-- Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent).
-- ==============================================================================

DROP POLICY IF EXISTS "Allow delete executive order persons" ON public.executive_order_persons;

DROP POLICY IF EXISTS "Allow delete executive orders items" ON public.executive_orders;

DROP POLICY IF EXISTS "Allow delete executive orders files" ON storage.objects;

-- 1) Ã˜Â­Ã˜Â°Ã™Â Ã˜ÂµÃ™Â Ã˜Â§Ã™â€žÃ˜Â´Ã˜Â®Ã˜Âµ (Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜ÂªÃ˜Â¨Ã˜Â·Ã˜Â© Ã˜ÂªÃ™ÂÃ˜Â­Ã˜Â°Ã™Â Ã˜ÂªÃ™â€žÃ™â€šÃ˜Â§Ã˜Â¦Ã™Å Ã™â€¹Ã˜Â§ Ã˜Â¹Ã˜Â¨Ã˜Â± ON DELETE CASCADE)
CREATE POLICY "Allow delete executive order persons"
  ON public.executive_order_persons FOR DELETE
  TO anon, authenticated USING (true);

-- 2) Ã˜Â­Ã˜Â°Ã™Â Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â± Ã™â€¦Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â±Ã˜Â© (Ã˜Â§Ã˜Â­Ã˜ÂªÃ™Å Ã˜Â§Ã˜Â·Ã™Å )
CREATE POLICY "Allow delete executive orders items"
  ON public.executive_orders FOR DELETE
  TO anon, authenticated USING (true);

-- 3) Ã˜Â­Ã˜Â°Ã™Â Ã™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª PDF Ã™â€¦Ã™â€  Ã˜Â¨Ã™Æ’Ã˜Âª storage Ã˜Â¨Ã™â€¦Ã˜Â¬Ã˜Â±Ã˜Â¯ Ã˜Â£Ã™â€  Ã˜ÂªÃ™Æ’Ã™Ë†Ã™â€  Ã™â€žÃ˜Â¨Ã™Æ’Ã˜Âª executive-orders
CREATE POLICY "Allow delete executive orders files"
  ON storage.objects FOR DELETE
  TO anon, authenticated USING (bucket_id = 'executive-orders');

-- Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™Æ’Ã˜Â§Ã˜Â´ PostgREST
NOTIFY pgrst, 'reload schema';


-- ==== fix_issue_details_save.sql ====================================
-- ============================================================================
-- Ã˜Â¥Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­ Ã˜Â­Ã™ÂÃ˜Â¸ Ã˜ÂªÃ˜Â¹Ã˜Â¯Ã™Å Ã™â€žÃ˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§ Ã™â€ Ã™â€¡Ã˜Â§Ã˜Â¦Ã™Å Ã™â€¹Ã˜Â§
-- Ã˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â° Ã™ÂÃ™Å  Supabase SQL Editor
-- ============================================================================
-- Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â¨Ã˜Â¨ Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â°Ã˜Â±Ã™Å : Ã˜ÂªÃ˜Â·Ã˜Â¨Ã™Å Ã™â€š Ã˜Â³Ã˜Â·Ã˜Â­ Ã˜Â§Ã™â€žÃ™â€¦Ã™Æ’Ã˜ÂªÃ˜Â¨ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â«Ã˜Â¨Ã™Å½Ã™â€˜Ã˜Âª (Ã˜Â§Ã™â€žÃ™â€ Ã™ÂÃ˜Â³Ã˜Â® Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â©) Ã™Å Ã™ÂÃ˜Â¯Ã˜Â®Ã™â€ž Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ status
-- Ã˜Â¹Ã™â€ Ã˜Â¯ Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜ÂµÃ™Â Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯ Ã™ÂÃ™Å  Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž issue_detailsÃ˜Å’ Ã™Ë†Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã˜ÂºÃ™Å Ã˜Â± Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã™ÂÃ™Å  Ã™â€šÃ˜Â§Ã˜Â¹Ã˜Â¯Ã˜Â©
-- Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜ÂªÃ˜Å’ Ã™ÂÃ™Æ’Ã˜Â§Ã™â€ Ã˜Âª Ã™Æ’Ã™â€ž Ã˜Â¹Ã™â€¦Ã™â€žÃ™Å Ã˜Â© Ã˜Â­Ã™ÂÃ˜Â¸ Ã˜ÂªÃ™ÂÃ˜Â´Ã™â€ž Ã˜Â¨Ã˜ÂµÃ™â€¦Ã˜Âª (Ã˜Â®Ã˜Â·Ã˜Â£ PGRST204) Ã™Ë†Ã˜ÂªÃ™ÂÃ˜Â¹Ã˜Â±Ã˜Â¶ Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€žÃ˜Â© Ã™â€ Ã˜Â¬Ã˜Â§Ã˜Â­
-- Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â­Ã™ÂÃ˜Â¸ Ã˜Â£Ã™Å  Ã˜Â´Ã™Å Ã˜Â¡ Ã¢â‚¬â€ Ã™â€žÃ˜Â°Ã™â€žÃ™Æ’ "Ã™â€¦Ã˜Â´ Ã˜Â¨Ã™Å Ã˜ÂªÃ˜Â­Ã™ÂÃ˜Â¸ Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â¹Ã˜Â¯Ã™Å Ã™â€žÃ˜Â§Ã˜Âª".
--
-- Ã˜Â§Ã™â€žÃ˜Â­Ã™â€ž Ã™â€¡Ã™â€ Ã˜Â§ Ã™â€¦Ã™Æ’Ã™Ë†Ã™Å½Ã™â€˜Ã™â€  Ã™â€¦Ã™â€  3 Ã˜Â®Ã˜Â·Ã™Ë†Ã˜Â§Ã˜Âª Ã™â€šÃ˜Â§Ã˜Â¨Ã™â€žÃ˜Â© Ã™â€žÃ™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â° Ã˜Â¨Ã˜Â£Ã™â€¦Ã˜Â§Ã™â€  (Idempotent):
--   1) Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ status Ã˜Â¥Ã˜Â°Ã˜Â§ Ã™Æ’Ã˜Â§Ã™â€  Ã™â€ Ã˜Â§Ã™â€šÃ˜ÂµÃ™â€¹Ã˜Â§ (Ã™Å Ã™Ë†Ã™ÂÃ™â€˜Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂªÃ™Ë†Ã˜Â§Ã™ÂÃ™â€š Ã™â€¦Ã˜Â¹ Ã™Æ’Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã™ÂÃ˜Â³Ã˜Â®).
--   2) Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â£Ã™Æ’Ã˜Â¯ Ã™â€¦Ã™â€  Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã™ÂÃ™â€¡Ã˜Â±Ã˜Â³ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ˜Â©.
--   3) Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â£Ã™Æ’Ã˜Â¯ Ã™â€¦Ã™â€  Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª RLS Ã™â€žÃ™â€žÃ™â€šÃ˜Â±Ã˜Â§Ã˜Â¡Ã˜Â©/Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â©/Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â«/Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â°Ã™Â
--      Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€žÃ™Å  issues Ã™Ë† issue_details.
-- ============================================================================

-- 1) Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ status Ã™ÂÃ™Å  Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§
ALTER TABLE issue_details
  ADD COLUMN IF NOT EXISTS status VARCHAR(50) DEFAULT 'pending';

COMMENT ON COLUMN issue_details.status IS
  'Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã™Å Ã˜Â©: pending, completed';

-- 2) Ã™ÂÃ™â€¡Ã˜Â±Ã˜Â³ Ã˜Â§Ã™â€žÃ˜Â¨Ã˜Â­Ã˜Â« Ã˜Â­Ã˜Â³Ã˜Â¨ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ˜Â©
CREATE INDEX IF NOT EXISTS idx_issue_details_status ON issue_details(status);

-- 3) Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª RLS Ã¢â‚¬â€ Ã˜ÂªÃ™ÂÃ˜Â§Ã˜ÂµÃ™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§
ALTER TABLE issue_details ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "issue_details_select" ON issue_details;

CREATE POLICY "issue_details_select" ON issue_details
  FOR SELECT USING (true);

DROP POLICY IF EXISTS "issue_details_insert" ON issue_details;

CREATE POLICY "issue_details_insert" ON issue_details
  FOR INSERT WITH CHECK (true);

DROP POLICY IF EXISTS "issue_details_update" ON issue_details;

CREATE POLICY "issue_details_update" ON issue_details
  FOR UPDATE USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "issue_details_delete" ON issue_details;

CREATE POLICY "issue_details_delete" ON issue_details
  FOR DELETE USING (true);

-- 4) Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª RLS Ã¢â‚¬â€ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¶Ã˜Â§Ã™Å Ã˜Â§
ALTER TABLE issues ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "issues_select" ON issues;

CREATE POLICY "issues_select" ON issues
  FOR SELECT USING (true);

DROP POLICY IF EXISTS "issues_insert" ON issues;

CREATE POLICY "issues_insert" ON issues
  FOR INSERT WITH CHECK (true);

DROP POLICY IF EXISTS "issues_update" ON issues;

CREATE POLICY "issues_update" ON issues
  FOR UPDATE USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "issues_delete" ON issues;

CREATE POLICY "issues_delete" ON issues
  FOR DELETE USING (true);

-- Ã˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜ÂªÃ˜Â­Ã™â€¦Ã™Å Ã™â€ž Ã™â€¦Ã˜Â®Ã˜Â·Ã˜Â· PostgREST Ã˜Â­Ã˜ÂªÃ™â€° Ã˜ÂªÃ˜Â¸Ã™â€¡Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂªÃ˜ÂºÃ™Å Ã™Å Ã˜Â±Ã˜Â§Ã˜Âª Ã™ÂÃ™Ë†Ã˜Â±Ã™â€¹Ã˜Â§
NOTIFY pgrst, 'reload schema';


