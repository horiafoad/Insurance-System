  status VARCHAR(20) DEFAULT 'Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯' CHECK (status IN ('Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯', 'Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜Â§Ã˜Â¬Ã˜Â¹Ã˜Â©', 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°', 'Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž', 'Ã™â€¦Ã˜Â±Ã™ÂÃ™Ë†Ã˜Â¶')),
  notes TEXT,
