DO $$
DECLARE
  t text;
  target_tables text[] := ARRAY[
    'issues',                        -- file_url
    'issue_details',                 -- pdf_url
    'case_documents',                -- file_url
    'letters',                       -- image_url
    'faculty_salary_archive',        -- file_url / preview_url / preview_urls
    'employee_salary_archive',       -- file_url / preview_url / preview_urls
    'faculty_salary_imports',        -- file_url / storage_path
    'employee_salary_imports',       -- file_url / storage_path
    'executive_order_persons',       -- file_url / file_path
    'scanner_inbox',                 -- file_url / file_path
    'faculty_salary_pages',          -- page_image_url / source_file_url
    'salary_import_files'            -- file_url
  ];
BEGIN
  FOREACH t IN ARRAY target_tables LOOP
    IF EXISTS (
      SELECT 1 FROM information_schema.tables
      WHERE table_schema = 'public' AND table_name = t
    ) THEN
      EXECUTE format(
        'ALTER TABLE public.%I ADD COLUMN IF NOT EXISTS storage_provider text',
        t
      );
      -- Ã™Æ’Ã™â€ž Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ™Å Ã˜Â© supabase: Ã™â€žÃ˜Â§ Ã™â€ Ã˜Â¹Ã˜ÂªÃ™â€¦Ã˜Â¯ Ã˜Â¹Ã™â€žÃ™â€° NULL Ã™â€žÃ˜Â£Ã™â€ Ã™â€¡Ã˜Â§ Ã™â€šÃ˜Â¯ Ã˜ÂªÃ˜Â¹Ã™â€ Ã™Å  "Ã˜ÂºÃ™Å Ã˜Â± Ã™â€¦Ã˜Â¹Ã˜Â±Ã™Ë†Ã™Â"
      EXECUTE format(
        'UPDATE public.%I SET storage_provider = ''supabase'' WHERE storage_provider IS NULL',
        t
      );
      -- Ã™â€žÃ˜Â§ Ã™â€šÃ™Å Ã™â€¦Ã˜Â© Ã˜Â§Ã™ÂÃ˜ÂªÃ˜Â±Ã˜Â§Ã˜Â¶Ã™Å Ã˜Â©: Ã™Æ’Ã™â€ž Ã™Æ’Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â© Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â© Ã˜ÂªÃ™â€¦Ã˜Â± Ã˜Â¹Ã˜Â¨Ã˜Â± Ã˜Â·Ã˜Â¨Ã™â€šÃ˜Â© fileStorage.js
    ELSE
      RAISE NOTICE 'Ã˜ÂªÃ˜Â®Ã˜Â·Ã™â€˜Ã™Å  Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜ÂºÃ™Å Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯: %', t;
    END IF;
  END LOOP;
END $$;

-- ---------------------------------------------------------------------------
-- 2) Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ storage_key: Ã™â€¦Ã˜Â³Ã˜Â§Ã˜Â± R2 Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â§Ã˜Â¦Ã™â€¦ (Ã˜Â§Ã˜Â®Ã˜ÂªÃ™Å Ã˜Â§Ã˜Â±Ã™Å  Ã™â€žÃ™Æ’Ã™â€ Ã™â€¡ Ã™Å Ã˜Â¨Ã˜Â³Ã™â€˜Ã˜Â· Ã˜Â§Ã™â€žÃ˜ÂªÃ˜ÂªÃ˜Â¨Ã˜Â¹)
--    Ã™Å Ã™ÂÃ™â€¦Ã™â€žÃ˜Â£ Ã™ÂÃ™â€šÃ˜Â· Ã˜Â¹Ã™â€ Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã˜Â­Ã™Å Ã™â€ž Ã˜Â¥Ã™â€žÃ™â€° R2. Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© Ã˜ÂªÃ˜Â¨Ã™â€šÃ™â€° NULL.
-- ---------------------------------------------------------------------------
DO $$
DECLARE
  t text;
  target_tables text[] := ARRAY[
    'issues',
    'issue_details',
    'case_documents',
    'letters',
    'faculty_salary_archive',
    'employee_salary_archive',
    'faculty_salary_imports',
    'employee_salary_imports',
    'executive_order_persons',
    'scanner_inbox',
    'faculty_salary_pages',
    'salary_import_files'
  ];
BEGIN
  FOREACH t IN ARRAY target_tables LOOP
    IF EXISTS (
      SELECT 1 FROM information_schema.tables
      WHERE table_schema = 'public' AND table_name = t
    ) THEN
      EXECUTE format(
        'ALTER TABLE public.%I ADD COLUMN IF NOT EXISTS storage_key text',
        t
      );
    END IF;
  END LOOP;
END $$;

-- ---------------------------------------------------------------------------
-- 3) Ã™â€šÃ™Å Ã™Ë†Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â³Ã™â€žÃ˜Â§Ã™â€¦Ã˜Â©: Ã™Å Ã™ÂÃ™â€šÃ˜Â¨Ã™â€ž Ã™ÂÃ™â€šÃ˜Â· 'supabase' Ã˜Â£Ã™Ë† 'r2'
--    (Ã™â€žÃ˜Â§ Ã™Å Ã™ÂÃ˜Â¶Ã˜Â§Ã™Â Ã˜Â¥Ã™â€  Ã™Æ’Ã˜Â§Ã™â€  Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ Ã™â€ Ã˜Â§Ã™â€šÃ˜ÂµÃ™â€¹Ã˜Â§ Ã¢â‚¬â€ Ã˜Â§Ã™â€žÃ˜ÂªÃ™ÂÃ˜Â§Ã™Â Ã˜Â­Ã˜ÂªÃ™â€° Ã™â€žÃ˜Â§ Ã™Å Ã™ÂÃ˜Â´Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª)
-- ---------------------------------------------------------------------------
DO $$
DECLARE
  t text;
  target_tables text[] := ARRAY[
    'issues', 'issue_details', 'case_documents', 'letters',
    'faculty_salary_archive', 'employee_salary_archive',
    'faculty_salary_imports', 'employee_salary_imports',
    'executive_order_persons', 'scanner_inbox',
    'faculty_salary_pages', 'salary_import_files'
  ];
BEGIN
  FOREACH t IN ARRAY target_tables LOOP
    IF EXISTS (
      SELECT 1 FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = t
        AND column_name = 'storage_provider'
    ) THEN
      EXECUTE format(
        'ALTER TABLE public.%I DROP CONSTRAINT IF EXISTS chk_%I_storage_provider',
        t, t
      );
      EXECUTE format(
        'ALTER TABLE public.%I ADD CONSTRAINT chk_%I_storage_provider
           CHECK (storage_provider IS NULL OR storage_provider IN (''supabase'',''r2''))',
        t, t
      );
    END IF;
  END LOOP;
END $$;

CREATE INDEX IF NOT EXISTS idx_sml_status
  ON public.storage_migration_log (status);

CREATE INDEX IF NOT EXISTS idx_sr2o_bucket
  ON public.storage_r2_objects (logical_bucket);

-- ---------------------------------------------------------------------------
-- 5) Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­Ã™Å Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â© (Ã™â€ Ã™ÂÃ˜Â³ Ã™â€ Ã™â€¦Ã˜Â· Ã˜Â¨Ã™â€šÃ™Å Ã˜Â© Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹)
-- ---------------------------------------------------------------------------
ALTER TABLE public.storage_migration_log ENABLE ROW LEVEL SECURITY;

ALTER TABLE public.storage_r2_objects ENABLE ROW LEVEL SECURITY;

-- Ã˜Â§Ã™â€žÃ™Æ’Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â© Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â§Ã˜Â¯Ã™â€¦ Ã™ÂÃ™â€šÃ˜Â· (service_role) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â§Ã˜Âª Ã˜Â¹Ã˜Â§Ã™â€¦Ã˜Â©
DROP POLICY IF EXISTS "sml_read_for_app" ON public.storage_migration_log;

CREATE POLICY "sml_read_for_app"
  ON public.storage_migration_log FOR SELECT
  TO anon, authenticated USING (true);

DROP POLICY IF EXISTS "sr2o_read_for_app" ON public.storage_r2_objects;

CREATE POLICY "sr2o_read_for_app"
  ON public.storage_r2_objects FOR SELECT
  TO anon, authenticated USING (true);

-- Ã˜Â§Ã™â€žÃ™Æ’Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â© Ã™â€¦Ã™â€  Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â§Ã˜Â¯Ã™â€¦ Ã™ÂÃ™â€šÃ˜Â· (service_role) Ã¢â‚¬â€ Ã™â€žÃ˜Â§ Ã˜ÂªÃ™Ë†Ã˜Â¬Ã˜Â¯ Ã˜Â³Ã™Å Ã˜Â§Ã˜Â³Ã˜Â© INSERT/UPDATE/DELETEÃ˜Å’
-- Ã™â€žÃ˜Â°Ã™â€žÃ™Æ’ Ã™â€žÃ˜Â§ Ã™Å Ã˜Â³Ã˜ÂªÃ˜Â·Ã™Å Ã˜Â¹ anon Ã™Ë†Ã™â€žÃ˜Â§ authenticated Ã˜Â§Ã™â€žÃ™Æ’Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â© Ã˜Â­Ã˜ÂªÃ™â€° Ã™â€¦Ã˜Â¹ Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ GRANT.
-- Ã™Å Ã™ÂÃ™â€¦Ã™â€ Ã˜Â­ anon/authenticated Ã™â€šÃ˜Â±Ã˜Â§Ã˜Â¡Ã˜Â© Ã™ÂÃ™â€šÃ˜Â· Ã™â€žÃ˜Â£Ã™â€  Ã˜Â§Ã™â€žÃ™Ë†Ã˜Â§Ã˜Â¬Ã™â€¡Ã˜Â© Ã™â€šÃ˜Â¯ Ã˜ÂªÃ˜Â­Ã˜ÂªÃ˜Â§Ã˜Â¬ Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â±Ã˜Â¯.
GRANT SELECT ON public.storage_migration_log TO anon, authenticated;

GRANT SELECT ON public.storage_r2_objects TO anon, authenticated;

GRANT ALL ON public.storage_migration_log TO postgres, service_role;

GRANT ALL ON public.storage_r2_objects TO postgres, service_role;

GRANT ALL ON SEQUENCE public.storage_migration_log_id_seq TO postgres, service_role;

GRANT ALL ON SEQUENCE public.storage_r2_objects_id_seq TO postgres, service_role;

-- ---------------------------------------------------------------------------
-- 6) Ã˜ÂªÃ˜Â­Ã™â€šÃ™â€˜Ã™â€š: Ã™Å Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã™â€¦Ã˜Â§ Ã˜ÂªÃ™â€¦Ã™â€˜Ã˜Âª Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜ÂªÃ™â€¡
-- ---------------------------------------------------------------------------
SELECT table_name,
       column_name,
       data_type
FROM information_schema.columns
WHERE table_schema = 'public'
  AND column_name IN ('storage_provider', 'storage_key')
ORDER BY table_name, column_name;

NOTIFY pgrst, 'reload schema';


-- ==== create_employee_evaluations_table.sql ====================================
-- Ã˜ÂªÃ˜Â¹Ã˜Â·Ã™Å Ã™â€ž RLS Ã™â€žÃ™â€žÃ˜Â³Ã™â€¡Ã™Ë†Ã™â€žÃ˜Â©
ALTER TABLE employee_tasks DISABLE ROW LEVEL SECURITY;

-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã™ÂÃ™â€¡Ã˜Â§Ã˜Â±Ã˜Â³ Ã™â€žÃ™â€žÃ˜Â¨Ã˜Â­Ã˜Â« Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â±Ã™Å Ã˜Â¹
CREATE INDEX IF NOT EXISTS idx_employee_tasks_employee_id ON employee_tasks(employee_id);

CREATE INDEX IF NOT EXISTS idx_employee_tasks_status ON employee_tasks(status);

CREATE INDEX IF NOT EXISTS idx_employee_tasks_priority ON employee_tasks(priority);

CREATE INDEX IF NOT EXISTS idx_employee_tasks_due_date ON employee_tasks(due_date);

CREATE INDEX IF NOT EXISTS idx_employee_tasks_month_year ON employee_tasks(task_month, task_year);

-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜ÂªÃ˜Â¹Ã™â€žÃ™Å Ã™â€š Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž
COMMENT ON TABLE employee_tasks IS 'Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã™â€¦Ã™Ë†Ã˜Â¸Ã™ÂÃ™Å  Ã™â€šÃ˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ˜Â­Ã™â€šÃ˜Â§Ã™â€šÃ˜Â§Ã˜Âª';

-- ============================================
-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜ÂªÃ˜Â¬Ã˜Â±Ã™Å Ã˜Â¨Ã™Å Ã˜Â©
-- ============================================

-- Ã™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã™â€žÃ™Æ’Ã™â€ž Ã™â€¦Ã™Ë†Ã˜Â¸Ã™Â - Ã˜Â´Ã™â€¡Ã˜Â± Ã˜Â£Ã˜ÂºÃ˜Â³Ã˜Â·Ã˜Â³ 2026

-- [REMOVED by build-new-schema] sample/reference seed for a table whose rows come from the OLD export


-- ============================================
-- Ã˜Â§Ã˜Â³Ã˜ÂªÃ˜Â¹Ã™â€žÃ˜Â§Ã™â€¦Ã˜Â§Ã˜Âª Ã™â€¦Ã™ÂÃ™Å Ã˜Â¯Ã˜Â©
-- ============================================

-- Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã˜Â¬Ã™â€¦Ã™Å Ã˜Â¹ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã™â€¦Ã˜Â¹ Ã˜Â§Ã˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¸Ã™Â
SELECT 
  t.id,
  t.employee_id,
  CASE t.employee_id
    WHEN 1 THEN 'Ã˜ÂµÃ™ÂÃ˜Â§Ã˜Â¡ Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 2 THEN 'Ã™Å Ã˜Â§Ã˜Â³Ã™â€¦Ã™Å Ã™â€  Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 3 THEN 'Ã˜Â­Ã™Ë†Ã˜Â±Ã™Å Ã˜Â© Ã™ÂÃ˜Â¤Ã˜Â§Ã˜Â¯'
    WHEN 4 THEN 'Ã˜Â£Ã™â€¦Ã˜Â§Ã™â€ Ã™Å  Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­'
    WHEN 5 THEN 'Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€žÃ™â€¡ Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â¹Ã™Å Ã˜Â¯'
    WHEN 6 THEN 'Ã˜Â¬Ã™â€¡Ã˜Â§Ã˜Â¯ Ã˜Â¹Ã˜Â§Ã˜Â·Ã™Â'
  END as employee_name,
  t.title,
  t.description,
  t.due_date,
  t.task_month,
  t.task_year,
  t.status,
  t.priority,
  t.created_at
FROM employee_tasks t
ORDER BY t.created_at DESC;

-- Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã™â€¦Ã™â€žÃ˜Â®Ã˜Âµ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã™â€žÃ™Æ’Ã™â€ž Ã™â€¦Ã™Ë†Ã˜Â¸Ã™Â Ã˜Â­Ã˜Â³Ã˜Â¨ Ã˜Â§Ã™â€žÃ˜Â´Ã™â€¡Ã˜Â±
SELECT 
  employee_id,
  CASE employee_id
    WHEN 1 THEN 'Ã˜ÂµÃ™ÂÃ˜Â§Ã˜Â¡ Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 2 THEN 'Ã™Å Ã˜Â§Ã˜Â³Ã™â€¦Ã™Å Ã™â€  Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 3 THEN 'Ã˜Â­Ã™Ë†Ã˜Â±Ã™Å Ã˜Â© Ã™ÂÃ˜Â¤Ã˜Â§Ã˜Â¯'
    WHEN 4 THEN 'Ã˜Â£Ã™â€¦Ã˜Â§Ã™â€ Ã™Å  Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­'
    WHEN 5 THEN 'Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€žÃ™â€¡ Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â¹Ã™Å Ã˜Â¯'
    WHEN 6 THEN 'Ã˜Â¬Ã™â€¡Ã˜Â§Ã˜Â¯ Ã˜Â¹Ã˜Â§Ã˜Â·Ã™Â'
  END as employee_name,
  task_month,
  task_year,
  COUNT(*) as total_tasks,
  SUM(CASE WHEN status = 'Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž' THEN 1 ELSE 0 END) as completed,
  SUM(CASE WHEN status = 'Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯' OR status = 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å ' THEN 1 ELSE 0 END) as pending,
  SUM(CASE WHEN status = 'Ã™â€¦Ã˜ÂªÃ˜Â£Ã˜Â®Ã˜Â±' THEN 1 ELSE 0 END) as late
FROM employee_tasks
GROUP BY employee_id, task_month, task_year
ORDER BY task_year DESC, task_month DESC, employee_id;

-- Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜Â£Ã˜Â®Ã˜Â±Ã˜Â©
SELECT 
  t.*,
  CASE t.employee_id
    WHEN 1 THEN 'Ã˜ÂµÃ™ÂÃ˜Â§Ã˜Â¡ Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 2 THEN 'Ã™Å Ã˜Â§Ã˜Â³Ã™â€¦Ã™Å Ã™â€  Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™Ë†Ã™â€¡Ã˜Â§Ã˜Â¨'
    WHEN 3 THEN 'Ã˜Â­Ã™Ë†Ã˜Â±Ã™Å Ã˜Â© Ã™ÂÃ˜Â¤Ã˜Â§Ã˜Â¯'
    WHEN 4 THEN 'Ã˜Â£Ã™â€¦Ã˜Â§Ã™â€ Ã™Å  Ã˜ÂµÃ™â€žÃ˜Â§Ã˜Â­'
    WHEN 5 THEN 'Ã˜Â¹Ã˜Â¨Ã˜Â¯ Ã˜Â§Ã™â€žÃ™â€žÃ™â€¡ Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â¹Ã™Å Ã˜Â¯'
    WHEN 6 THEN 'Ã˜Â¬Ã™â€¡Ã˜Â§Ã˜Â¯ Ã˜Â¹Ã˜Â§Ã˜Â·Ã™Â'
  END as employee_name
FROM employee_tasks t
WHERE t.status = 'Ã™â€¦Ã˜ÂªÃ˜Â£Ã˜Â®Ã˜Â±' OR (t.due_date < CURRENT_DATE AND t.status != 'Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž')
ORDER BY t.due_date ASC;

-- Ã˜Â¹Ã˜Â±Ã˜Â¶ Ã™â€¦Ã™â€¡Ã˜Â§Ã™â€¦ Ã™â€¦Ã™Ë†Ã˜Â¸Ã™Â Ã™â€¦Ã˜Â¹Ã™Å Ã™â€  Ã™â€žÃ˜Â´Ã™â€¡Ã˜Â± Ã™â€¦Ã˜Â¹Ã™Å Ã™â€ 
SELECT * FROM employee_tasks
WHERE employee_id = 1 AND task_month = 8 AND task_year = 2026
ORDER BY due_date ASC;


-- ==== create_letter_sectors.sql ====================================
-- Ã™ÂÃ™â€¡Ã˜Â±Ã˜Â³ Ã™â€žÃ™â€žÃ˜Â¨Ã˜Â­Ã˜Â« Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â±Ã™Å Ã˜Â¹
CREATE INDEX IF NOT EXISTS idx_letter_departments_sector_id
  ON public.letter_departments(sector_id);

-- Ã˜ÂªÃ˜Â¹Ã˜Â·Ã™Å Ã™â€ž RLS (Ã™â€ Ã™ÂÃ˜Â³ Ã™â€ Ã™â€¦Ã˜Â· Ã˜Â¨Ã™â€šÃ™Å Ã˜Â© Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦)
ALTER TABLE public.letter_sectors DISABLE ROW LEVEL SECURITY;

GRANT ALL ON public.letter_sectors TO anon, authenticated, postgres, service_role;

GRANT ALL ON SEQUENCE public.letter_sectors_id_seq TO anon, authenticated, postgres, service_role;

-- Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™Æ’Ã˜Â§Ã˜Â´ PostgREST
NOTIFY pgrst, 'reload schema';


-- ==== create_letter_templates_and_numbering.sql ====================================
-- [REMOVED by build-new-schema] sample/reference seed for a table whose rows come from the OLD export


-- 3) Ã˜Â²Ã˜Â±Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜Â¹Ã˜Â¯Ã™â€˜Ã˜Â§Ã˜Â¯ Ã™â€¦Ã™â€  Ã˜Â£Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â±Ã™â€šÃ™â€¦ Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã™ÂÃ™Å  Ã˜Â§Ã™â€žÃ˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ™Å Ã˜Â© (Ã™â€¦Ã™â€  Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â´Ã™Å Ã˜Â¡)
WITH existing AS (
  SELECT MAX((regexp_match(letter_number, '([0-9]+)'))[1]::BIGINT) AS max_num
  FROM public.letters
  WHERE letter_number ~ '[0-9]'
)
UPDATE public.letter_number_counter c
SET last_number = COALESCE((SELECT max_num FROM existing), 0)
WHERE c.id = 1
  AND last_number < COALESCE((SELECT max_num FROM existing), 0);

-- 4) Ã˜Â¯Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â¥Ã˜Â±Ã˜Â¬Ã˜Â§Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜Â±Ã™â€šÃ™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â§Ã™â€žÃ™Å : Ã˜ÂªÃ˜Â³Ã˜ÂªÃ˜Â¯Ã˜Â¹Ã™â€° Ã™Ë†Ã™â€šÃ˜Âª Ã˜Â§Ã™â€žÃ˜Â­Ã™ÂÃ˜Â¸ Ã™â€žÃ˜Â¶Ã™â€¦Ã˜Â§Ã™â€  Ã˜Â¹Ã˜Â¯Ã™â€¦ Ã˜Â§Ã™â€žÃ˜ÂªÃ™Æ’Ã˜Â±Ã˜Â§Ã˜Â± Ã˜Â­Ã˜ÂªÃ™â€° Ã˜Â¨Ã˜Â¹Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â°Ã™Â
CREATE OR REPLACE FUNCTION public.get_next_letter_number()
RETURNS TEXT
LANGUAGE plpgsql
VOLATILE
AS $$
DECLARE
  next_num BIGINT;
  next_code TEXT;
BEGIN
  UPDATE public.letter_number_counter
     SET last_number = last_number + 1
   WHERE id = 1
   RETURNING last_number INTO next_num;

  IF next_num IS NULL THEN
    RAISE EXCEPTION 'letter_number_counter row missing';
  END IF;

  next_code := 'Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¨ ' || LPAD(next_num::TEXT, 4, '0');
  RETURN next_code;
END;
$$;

