  attendance_status VARCHAR(20) DEFAULT 'Ã™â€¦Ã˜Â³Ã˜Â¬Ã™â€ž' CHECK (attendance_status IN ('Ã™â€¦Ã˜Â³Ã˜Â¬Ã™â€ž', 'Ã˜Â­Ã˜Â¶Ã˜Â±', 'Ã˜ÂºÃ˜Â§Ã˜Â¦Ã˜Â¨', 'Ã˜Â§Ã˜Â¹Ã˜ÂªÃ˜Â°Ã˜Â±')),
  completion_status VARCHAR(20) DEFAULT 'Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â±' CHECK (completion_status IN ('Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â§Ã™â€ Ã˜ÂªÃ˜Â¸Ã˜Â§Ã˜Â±', 'Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž', 'Ã˜ÂºÃ™Å Ã˜Â± Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž')),
  notes TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

