-- ==== supabase_realtime_setup.sql ====================================
-- =====================================================
-- Ã˜ÂªÃ™ÂÃ˜Â¹Ã™Å Ã™â€ž Supabase Realtime Ã™â€žÃ™Æ’Ã™â€ž Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦
-- Ã™â€ Ã™ÂÃ™â€˜Ã˜Â° Ã™â€¡Ã˜Â°Ã˜Â§ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã™â€¦Ã˜Â±Ã˜Â© Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯Ã˜Â© Ã™ÂÃ™â€šÃ˜Â· Ã™â€¦Ã™â€ :
-- Supabase Dashboard Ã¢â€ â€™ SQL Editor
-- Ã˜Â¨Ã˜Â¹Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã˜Å’ Ã˜Â£Ã™Å  Ã˜Â¥Ã˜Â¯Ã˜Â±Ã˜Â§Ã˜Â¬ / Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« / Ã˜Â­Ã˜Â°Ã™Â Ã™ÂÃ™Å  Ã™â€¡Ã˜Â°Ã™â€¡ Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž
-- Ã™Å Ã™â€ Ã˜Â¹Ã™Æ’Ã˜Â³ Ã™ÂÃ™Ë†Ã˜Â±Ã™â€¹Ã˜Â§ Ã˜Â¹Ã™â€ Ã˜Â¯ Ã™Æ’Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â¯Ã™â€¦Ã™Å Ã™â€  Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ˜ÂµÃ™â€žÃ™Å Ã™â€  Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€ Ã¥Ë†Â·Ã¦â€“Â° Ã˜Â§Ã™â€žÃ˜ÂµÃ™ÂÃ˜Â­Ã˜Â©.
-- =====================================================

-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â§Ã™â€žÃ™â€ Ã˜Â´Ã˜Â± Ã˜Â¥Ã™â€  Ã™â€žÃ™â€¦ Ã™Å Ã™Æ’Ã™â€  Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã™â€¹Ã˜Â§ (Ã™â€¦Ã™ÂÃ™Å Ã˜Â¯ Ã˜Â¹Ã™â€ Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â§Ã™â€žÃ˜Â°Ã˜Â§Ã˜ÂªÃ™Å Ã˜Â©)
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_publication WHERE pubname = 'supabase_realtime') THEN
    CREATE PUBLICATION supabase_realtime;
  END IF;
END
$$;

-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â¥Ã™â€žÃ™â€° publication Ã˜Â¨Ã˜Â´Ã™Æ’Ã™â€ž Ã™â€¦Ã™ÂÃ˜Â³Ã˜ÂªÃ™â€šÃ˜Â±:
-- Ã™Å Ã˜ÂªÃ˜Â¬Ã˜Â§Ã™â€¡Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜ÂºÃ™Å Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â© (Ã™â€žÃ™â€¦ Ã™Å Ã™ÂÃ˜Â´Ã˜ÂºÃ™Å½Ã™â€˜Ã™â€ž Ã˜Â³Ã™Æ’Ã˜Â±Ã˜Â¨Ã˜Âª Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¦Ã™â€¡Ã˜Â§ Ã˜Â¨Ã˜Â¹Ã˜Â¯) Ã™Ë†Ã™Å Ã˜Â³Ã˜ÂªÃ™â€¦Ã˜Â± Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â£Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Â¡.
DO $$
DECLARE
  t TEXT;
  full_name TEXT;
BEGIN
  FOREACH t IN ARRAY ARRAY[
    'users',
    'tasks',
    'claims',
    'service_requests',
    'public_feedback',
    'employee_tasks',
    'performance_evaluations',
    'salary_requests',
    'welfare_requests',
    'fellowship_requests',
    'certificate_requests',
    'issues',
    'issue_details',
    'case_documents',
    'letters',
    'letter_movements',
    'letter_departments',
    'letter_senders',
    'letter_sectors',
    'letter_templates',
    'archive_qr_codes',
    'training_courses',
    'course_registrations',
    'executive_orders',
    'executive_order_persons',
    'scanner_inbox',
    'faculty_salary_archive',
    'employee_salary_archive',
    'salary_import_files',
    'faculty_salary_pages'
  ] LOOP
    full_name := format('public.%I', t);

    -- Ã˜ÂªÃ˜Â®Ã˜Â·Ã™Å  Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜ÂºÃ™Å Ã˜Â± Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â© Ã™ÂÃ™Å  Ã˜Â§Ã™â€žÃ™â€šÃ˜Â§Ã˜Â¹Ã˜Â¯Ã˜Â©
    IF to_regclass(full_name) IS NULL THEN
      RAISE NOTICE 'SKIP % (table does not exist)', full_name;
      CONTINUE;
    END IF;

    IF NOT EXISTS (
      SELECT 1
        FROM pg_publication_tables
       WHERE pubname = 'supabase_realtime'
         AND schemaname = 'public'
         AND tablename = t
    ) THEN
      EXECUTE format('ALTER PUBLICATION supabase_realtime ADD TABLE %s', full_name);
      RAISE NOTICE 'ADDED % TO supabase_realtime', full_name;
    ELSE
      RAISE NOTICE 'SKIP % (already published)', full_name;
    END IF;
  END LOOP;
END
$$;


-- ==== upgrade_support_requests_remote.sql ====================================
-- ==============================================================================
-- Ã˜ÂªÃ˜Â±Ã™â€šÃ™Å Ã˜Â© Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â·Ã™â€žÃ˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦ Ã˜Â§Ã™â€žÃ™ÂÃ™â€ Ã™Å  Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦ Ã˜Â¹Ã™â€  Ã˜Â¨Ã™ÂÃ˜Â¹Ã˜Â¯ Ã˜Â¹Ã˜Â¨Ã˜Â± MeshCentral
-- ----------------------------------------------
-- Ã™Å Ã™ÂÃ˜Â¨Ã™â€ Ã™â€° Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã™ÂÃ™Å  create_support_requests.sql (Ã™â€žÃ˜Â§ Ã™Å Ã˜Â­Ã˜Â°Ã™Â Ã˜Â£Ã™Å  Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª).
-- Ã˜Â§Ã™â€žÃ˜Â³Ã™Æ’Ã˜Â±Ã™Å Ã˜Â¨Ã˜Âª Ã˜Â¢Ã™â€¦Ã™â€  Ã™â€žÃ˜Â¥Ã˜Â¹Ã˜Â§Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž (idempotent) Ã¢â‚¬â€ Ã™â€ Ã™ÂÃ™â€˜Ã˜Â°Ã™â€¡ Ã™â€¦Ã™â€  Supabase -> SQL Editor.
--
-- Ã™Å Ã˜Â¶Ã™Å Ã™Â:
--   * department_id      : Ã˜Â±Ã˜Â§Ã˜Â¨Ã˜Â· Ã˜Â¨Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ™Å Ã˜Â© Ã˜Â¨Ã˜Â¯Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ department_name Ã˜Â§Ã™â€žÃ™â€ Ã˜ÂµÃ™Å .
--   * mesh_device_id     : Ã™â€¦Ã˜Â¹Ã˜Â±Ã™Â Ã˜Â§Ã™â€žÃ˜Â¬Ã™â€¡Ã˜Â§Ã˜Â² Ã™ÂÃ™Å  MeshCentral.
--   * device_name        : Ã˜Â§Ã˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â¬Ã™â€¡Ã˜Â§Ã˜Â² (Ã™Å Ã˜Â¸Ã™â€¡Ã˜Â± Ã™ÂÃ™Å  Ã™â€žÃ™Ë†Ã˜Â­Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â© Ã™Ë†MeshCentral).
--   * assigned_admin_*   : Ã™â€¦Ã˜Â³Ã˜Â¤Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦ Ã˜Â§Ã™â€žÃ˜Â°Ã™Å  Ã˜Â¨Ã˜Â¯Ã˜Â£ Ã˜Â§Ã™â€žÃ˜Â¬Ã™â€žÃ˜Â³Ã˜Â©.
--   * started_at/ended_at: Ã˜Â£Ã™Ë†Ã™â€šÃ˜Â§Ã˜Âª Ã˜Â¨Ã˜Â¯Ã˜Â¡ Ã™Ë†Ã™â€ Ã™â€¡Ã˜Â§Ã™Å Ã˜Â© Ã˜Â¬Ã™â€žÃ˜Â³Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦.
--   * resolution_notes   : Ã™â€¦Ã™â€žÃ˜Â§Ã˜Â­Ã˜Â¸Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â­Ã™â€ž.
--   * Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â§Ã˜Âª Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â©: 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦' Ã™Ë†'Ã™â€¦Ã˜ÂºÃ™â€žÃ™â€šÃ˜Â©' (Ã™â€¦Ã˜Â¹ Ã˜Â§Ã™â€žÃ˜Â¥Ã˜Â¨Ã™â€šÃ˜Â§Ã˜Â¡ Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ™â€šÃ™Å Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂªÃ™Ë†Ã˜Â§Ã™ÂÃ™â€šÃ˜Â©).
-- ==============================================================================

-- 1. Ã˜Â£Ã˜Â¹Ã™â€¦Ã˜Â¯Ã˜Â© Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â© (IF NOT EXISTS = Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â£Ã˜Â«Ã˜Â± Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯Ã˜Â©)
ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS department_id BIGINT REFERENCES public.letter_departments(id);

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS mesh_device_id TEXT;

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS device_name VARCHAR(200);

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS assigned_admin_id UUID REFERENCES public.users(id) ON DELETE SET NULL;

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS assigned_admin_name VARCHAR(150);

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS started_at TIMESTAMP WITH TIME ZONE;

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS ended_at TIMESTAMP WITH TIME ZONE;

ALTER TABLE public.support_requests
  ADD COLUMN IF NOT EXISTS resolution_notes TEXT;

-- 2. Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™â€šÃ™Å Ã˜Â¯ Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â·Ã™â€žÃ˜Â¨:
--    Ã˜Â§Ã™â€žÃ˜Â­Ã™ÂÃ˜Â§Ã˜Â¸ Ã˜Â¹Ã™â€žÃ™â€° Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ˜Â© Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â© 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¹Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â©' Ã˜Â³Ã˜Â§Ã˜Â±Ã™Å Ã˜Â© (Ã˜ÂªÃ™Ë†Ã˜Â¬Ã˜Â¯ Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜Â¨Ã™â€¡Ã˜Â§),
--    Ã™Ë†Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦' Ã™Ë†'Ã™â€¦Ã˜ÂºÃ™â€žÃ™â€šÃ˜Â©' Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â·Ã™â€žÃ™Ë†Ã˜Â¨Ã˜ÂªÃ™Å Ã™â€ .
ALTER TABLE public.support_requests DROP CONSTRAINT IF EXISTS support_requests_status_check;

ALTER TABLE public.support_requests
  ADD CONSTRAINT support_requests_status_check
  CHECK (status IN ('Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯Ã˜Â©', 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â¹Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â©', 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å  Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦', 'Ã˜ÂªÃ™â€¦ Ã˜Â§Ã™â€žÃ˜Â­Ã™â€ž', 'Ã™â€¦Ã˜ÂºÃ™â€žÃ™â€šÃ˜Â©'));

-- 3. Ã™ÂÃ™â€¡Ã˜Â§Ã˜Â±Ã˜Â³ Ã™â€žÃ™â€žÃ˜Â¨Ã˜Â­Ã˜Â« Ã˜Â§Ã™â€žÃ˜Â³Ã˜Â±Ã™Å Ã˜Â¹ Ã˜Â­Ã˜Â³Ã˜Â¨ Ã˜Â§Ã™â€žÃ˜Â­Ã˜Â§Ã™â€žÃ˜Â© Ã™Ë†Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â³Ã˜Â¤Ã™Ë†Ã™â€ž
CREATE INDEX IF NOT EXISTS idx_support_requests_assigned_admin
  ON public.support_requests(assigned_admin_id, created_at DESC);

-- 4. Ã˜Â§Ã™â€žÃ˜Â£Ã™â€¦Ã˜Â§Ã™â€ : Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ™â€¦Ã˜Â±Ã˜Â§Ã˜Â± Ã˜Â¹Ã™â€žÃ™â€° Ã™â€ Ã™ÂÃ˜Â³ Ã™â€ Ã™â€¦Ã˜Â· Ã˜Â¨Ã˜Â§Ã™â€šÃ™Å  Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ™â€ Ã˜Â¸Ã˜Â§Ã™â€¦ (RLS Ã™â€¦Ã˜Â¹Ã˜Â·Ã™â€˜Ã™â€ž Ã¢â‚¬â€ Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â®Ã™Ë†Ã™â€ž Ã™â€¦Ã˜Â®Ã˜ÂµÃ˜Âµ Ã™â€žÃ™â€žÃ™â€¦Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹)
ALTER TABLE public.support_requests DISABLE ROW LEVEL SECURITY;

GRANT ALL ON TABLE public.support_requests TO anon, authenticated, postgres, service_role;

-- 5. Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â£Ã™Æ’Ã˜Â¯ Ã™â€¦Ã™â€  Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã™ÂÃ™Å  Realtime (Ã™â€žÃ™â€žÃ˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã˜Â§Ã™â€žÃ™ÂÃ™Ë†Ã˜Â±Ã™Å  Ã˜Â¹Ã™â€ Ã˜Â¯ Ã™â€¦Ã˜Â³Ã˜Â¤Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â¯Ã˜Â¹Ã™â€¦ Ã™Ë†Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¸Ã™Â)
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_publication WHERE pubname = 'supabase_realtime') THEN
    CREATE PUBLICATION supabase_realtime;
  END IF;
END
$$;

DO $$
BEGIN
  IF to_regclass('public.support_requests') IS NULL THEN
    RAISE NOTICE 'SKIP support_requests (table does not exist)';
    RETURN;
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
     WHERE pubname = 'supabase_realtime'
       AND schemaname = 'public'
       AND tablename = 'support_requests'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE public.support_requests;
    RAISE NOTICE 'ADDED support_requests TO supabase_realtime';
  ELSE
    RAISE NOTICE 'SKIP support_requests (already published)';
  END IF;
END
$$;

-- Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â« Ã™Æ’Ã˜Â§Ã˜Â´ PostgREST
NOTIFY pgrst, 'reload schema';


