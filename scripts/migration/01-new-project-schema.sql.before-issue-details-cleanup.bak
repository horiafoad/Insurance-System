-- from add_r2_storage_columns.sql
-- ---------------------------------------------------------------------------
-- 4) Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â³Ã˜Â¬Ã™â€ž Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã˜Â­Ã™Å Ã™â€ž (audit log)
--    Ã™Å Ã™Ë†Ã˜Â«Ã™â€˜Ã™â€š Ã™Æ’Ã™â€ž Ã™â€¦Ã™â€žÃ™Â Ã™â€ Ã™ÂÃ™â€šÃ™â€ž Ã˜Â£Ã™Ë† Ã™ÂÃ˜Â´Ã™â€žÃ˜Å’ Ã™â€žÃ™Å Ã™Æ’Ã™Ë†Ã™â€  Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â±Ã˜Â­Ã™Å Ã™â€ž Ã™â€šÃ˜Â§Ã˜Â¨Ã™â€žÃ™â€¹Ã˜Â§ Ã™â€žÃ™â€žÃ˜Â§Ã˜Â³Ã˜ÂªÃ˜Â¦Ã™â€ Ã˜Â§Ã™Â Ã™Ë†Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â¯Ã™â€šÃ™Å Ã™â€š.
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.storage_migration_log (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  supabase_bucket TEXT NOT NULL,
  object_path TEXT NOT NULL,
  r2_key TEXT,
  size_bytes BIGINT DEFAULT 0,
  mime_type TEXT,
  status TEXT NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'copied', 'verified', 'db_updated', 'failed', 'skipped')),
  rows_updated INTEGER DEFAULT 0,
  error TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  -- Ã˜Â£Ã™Å  Ã˜ÂµÃ™Â Ã™ÂÃ™Å  Ã™â€šÃ˜Â§Ã˜Â¹Ã˜Â¯Ã˜Â© Ã˜Â§Ã™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜ÂªÃ™â€¦ Ã˜ÂªÃ˜Â­Ã˜Â¯Ã™Å Ã˜Â«Ã™â€¡ (Ã™â€ Ã™ÂÃ˜Â³ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã™â€šÃ˜Â¯ Ã™Å Ã™ÂÃ˜Â´Ã˜Â§Ã˜Â± Ã˜Â¥Ã™â€žÃ™Å Ã™â€¡ Ã™â€¦Ã™â€  Ã˜Â£Ã™Æ’Ã˜Â«Ã˜Â± Ã™â€¦Ã™â€  Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž)
  -- row_id Ã™â€ Ã˜Âµ Ã™Ë†Ã™â€žÃ™Å Ã˜Â³ bigint: Ã™â€¦Ã™ÂÃ˜ÂªÃ˜Â§Ã˜Â­ salary_import_files Ã™â€¦Ã™â€  Ã™â€ Ã™Ë†Ã˜Â¹ UUID.
  -- Ã˜Â§Ã™â€žÃ™â€ Ã˜Âµ Ã™Å Ã™â€šÃ˜Â¨Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â§Ã˜Â«Ã™â€ Ã™Å Ã™â€  (Ã˜Â±Ã™â€šÃ™â€¦ Ã˜Â£Ã™Ë† UUID) Ã™ÂÃ™Å Ã˜Â®Ã˜Â²Ã™â€˜Ã™â€  Ã™Æ’Ã™â€¦Ã˜Â§ Ã™â€¡Ã™Ë† Ã˜Â¨Ã™â€žÃ˜Â§ Ã˜ÂªÃ˜Â­Ã™Ë†Ã™Å Ã™â€ž.
  table_name TEXT NOT NULL,
  row_id TEXT NOT NULL,
  first_seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  -- Ã˜Â§Ã™â€žÃ˜ÂªÃ™ÂÃ˜Â±Ã™â€˜Ã˜Â¯ Ã˜Â¹Ã™â€žÃ™â€° Ã™â€¦Ã˜Â³Ã˜ÂªÃ™Ë†Ã™â€° Ã˜Â§Ã™â€žÃ˜ÂµÃ™Â Ã™â€žÃ˜Â§ Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã˜Â¦Ã™â€ : Ã™â€ Ã™ÂÃ˜Â³ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã™â€šÃ˜Â¯ Ã™Å Ã™ÂÃ˜Â´Ã˜Â§Ã˜Â± Ã˜Â¥Ã™â€žÃ™Å Ã™â€¡ Ã™â€¦Ã™â€  Ã˜Â£Ã™Æ’Ã˜Â«Ã˜Â± Ã™â€¦Ã™â€ 
  -- Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â£Ã™Ë† Ã˜Â£Ã™Æ’Ã˜Â«Ã˜Â± Ã™â€¦Ã™â€  Ã˜ÂµÃ™ÂÃ˜Å’ Ã™Ë†Ã™Æ’Ã™â€ž Ã˜ÂµÃ™Â Ã™â€¦Ã™â€ Ã™â€¡Ã˜Â§ Ã™Å Ã˜Â¬Ã˜Â¨ Ã˜Â£Ã™â€  Ã™Å Ã™ÂÃ˜Â³Ã˜Â¬Ã™Å½Ã™â€˜Ã™â€ž Ã™ÂÃ™Å  Ã˜Â³Ã˜Â¬Ã™â€ž Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â¯Ã™â€šÃ™Å Ã™â€š.
  -- Ã˜ÂªÃ˜ÂªÃ˜Â¨Ã™â€˜Ã˜Â¹ Ã˜Â§Ã™â€žÃ™Æ’Ã˜Â§Ã˜Â¦Ã™â€  Ã™â€ Ã™ÂÃ˜Â³Ã™â€¡ (Ã™â€¦Ã˜Â±Ã˜Â© Ã™Ë†Ã˜Â§Ã˜Â­Ã˜Â¯Ã˜Â© Ã™â€žÃ™Æ’Ã™â€ž Ã™â€¦Ã™ÂÃ˜ÂªÃ˜Â§Ã˜Â­ R2) Ã™Å Ã˜ÂªÃ™â€¦ Ã™ÂÃ™Å  storage_r2_objects.
  UNIQUE (supabase_bucket, object_path, table_name, row_id)
);

-- from add_r2_storage_columns.sql
-- Ã˜Â³Ã˜Â¬Ã™â€ž Ã˜Â±Ã™Ë†Ã˜Â§Ã˜Â¨Ã˜Â· Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª Ã™ÂÃ™Å  R2 (Ã™Å Ã˜Â³Ã™â€¦Ã˜Â­ Ã˜Â¨Ã˜Â£Ã˜Â¯Ã˜Â§Ã˜Â¡ Ã˜Â¬Ã˜Â±Ã˜Â¯ R2 Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã™Ë†Ã˜Â± Ã˜Â¹Ã™â€žÃ™â€° Supabase)
CREATE TABLE IF NOT EXISTS public.storage_r2_objects (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  r2_key TEXT NOT NULL UNIQUE,
  logical_bucket TEXT NOT NULL,
  object_path TEXT NOT NULL,
  size_bytes BIGINT DEFAULT 0,
  mime_type TEXT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

