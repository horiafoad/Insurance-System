  source_mime TEXT,                                    -- Ã™â€ Ã™Ë†Ã˜Â¹ Ã™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ™â€¦Ã˜ÂµÃ˜Â¯Ã˜Â± (image/jpeg Ã˜Â£Ã™Ë† application/pdf)
  original_filename TEXT,                              -- Ã˜Â§Ã˜Â³Ã™â€¦ Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ˜Â£Ã˜ÂµÃ™â€žÃ™Å  Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã™ÂÃ™Ë†Ã˜Â¹
  page_start INTEGER,                                  -- Ã˜Â£Ã™Ë†Ã™â€ž Ã˜ÂµÃ™ÂÃ˜Â­Ã˜Â© Ã™â€žÃ™â€žÃ˜Â£Ã™â€¦Ã˜Â± Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ˜Â´Ã˜Â®Ã˜Âµ
  page_end INTEGER,                                    -- Ã˜Â¢Ã˜Â®Ã˜Â± Ã˜ÂµÃ™ÂÃ˜Â­Ã˜Â© Ã™â€žÃ™â€žÃ˜Â£Ã™â€¦Ã˜Â± Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã™â€¦Ã™â€žÃ™Â Ã˜Â§Ã™â€žÃ˜Â´Ã˜Â®Ã˜Âµ
  created_by TEXT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- from faculty_salary_archive_section.sql
-- ============================================================================
-- Ã˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â Ã™â€¦Ã™ÂÃ˜Â±Ã˜Â¯Ã˜Â§Ã˜Âª Ã™â€¦Ã˜Â±Ã˜ÂªÃ˜Â¨ Ã˜Â£Ã˜Â¹Ã˜Â¶Ã˜Â§Ã˜Â¡ Ã™â€¡Ã™Å Ã˜Â¦Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â¯Ã˜Â±Ã™Å Ã˜Â³ - Ã™â€šÃ˜Â³Ã™â€¦ Ã™â€¦Ã˜Â³Ã˜ÂªÃ™â€šÃ™â€ž Ã˜Â¬Ã˜Â¯Ã™Å Ã˜Â¯
-- (Independent section: does NOT touch letters / QR / scanner / templates / numbering)
--
-- Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â´Ã˜ÂºÃ™Å Ã™â€ž: Ã™â€¦Ã™â€  Supabase Dashboard -> SQL Editor -> New query -> Run
-- ============================================================================

-- ---------------------------------------------------------------
-- 1) Ã˜Â§Ã™â€žÃ˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¦Ã™Å Ã˜Â³Ã™Å  Ã™â€žÃ™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â
-- Ã˜Â±Ã˜Â¨Ã˜Â· Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™Â Ã˜Â¨Ã˜Â¹Ã˜Â¶Ã™Ë† Ã™â€¡Ã™Å Ã˜Â¦Ã˜Â© Ã˜Â§Ã™â€žÃ˜ÂªÃ˜Â¯Ã˜Â±Ã™Å Ã˜Â³ Ã™Å Ã˜ÂªÃ™â€¦ Ã˜Â¹Ã˜Â¨Ã˜Â± Ã˜Â¹Ã™â€¦Ã™Ë†Ã˜Â¯ computer_number
-- (Ã™â€¦Ã™ÂÃ˜ÂªÃ˜Â§Ã˜Â­ Ã˜Â§Ã™â€žÃ˜Â±Ã˜Â¨Ã˜Â·) + faculty_nameÃ˜Å’ Ã˜Â¨Ã™Å Ã™â€ Ã™â€¦Ã˜Â§ Mirror Ã™â€žÃ™â€žÃ˜Â¨Ã™â€ Ã™Å Ã˜Â© Ã˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Storage:
--   faculty-salary-archive/faculty-salaries/{computer_number}/{year}/{month}/{file}
-- ---------------------------------------------------------------
create table if not exists public.faculty_salary_archive (
  id bigint generated by default as identity primary key,
  faculty_name text not null,
  computer_number text not null,
  year integer not null,
  month integer not null check (month between 1 and 12),
  sequence integer not null default 1,
  file_url text not null,
  preview_url text,
  preview_urls text[] not null default '{}',
  page_count integer not null default 1,
  file_path text,
  original_filename text,
  created_by text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (computer_number, year, month, sequence)
);

-- from faculty_salary_archive_section.sql
-- ---------------------------------------------------------------
-- 2) Ã™â€šÃ˜Â§Ã˜Â¦Ã™â€¦Ã˜Â© Ã˜Â§Ã™â€žÃ™â€¦Ã˜Â±Ã˜Â§Ã˜Â¬Ã˜Â¹Ã˜Â© "Ã™Å Ã˜Â­Ã˜ÂªÃ˜Â§Ã˜Â¬ Ã™â€¦Ã˜Â±Ã˜Â§Ã˜Â¬Ã˜Â¹Ã˜Â©"
-- Ã˜Â§Ã™â€žÃ™â€¦Ã™â€žÃ™ÂÃ˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜ÂªÃ™Å  Ã™â€žÃ˜Â§ Ã™Å Ã™â€¦Ã™Æ’Ã™â€  Ã˜Â§Ã˜Â³Ã˜ÂªÃ˜Â®Ã˜Â±Ã˜Â§Ã˜Â¬ Ã˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜ÂªÃ™â€¡Ã˜Â§ Ã˜Â¨Ã˜Â´Ã™Æ’Ã™â€ž Ã™â€¦Ã™Ë†Ã˜Â«Ã™Ë†Ã™â€š Ã˜ÂªÃ˜Â°Ã™â€¡Ã˜Â¨ Ã™â€¡Ã™â€ Ã˜Â§
-- Ã™Ë†Ã™â€žÃ˜Â§ Ã™Å Ã˜ÂªÃ™â€¦ Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜ÂªÃ™â€¡Ã˜Â§ Ã™â€žÃ™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™Å Ã™Â Ã˜Â­Ã˜ÂªÃ™â€° Ã˜ÂªÃ˜ÂµÃ˜Â­Ã™Å Ã˜Â­Ã™â€¡Ã˜Â§ Ã™Å Ã˜Â¯Ã™Ë†Ã™Å Ã™â€¹Ã˜Â§.
-- ---------------------------------------------------------------
create table if not exists public.faculty_salary_imports (
  id bigint generated by default as identity primary key,
  file_name text not null,
  storage_path text,
  file_url text,
  page_count integer,
  extracted_name text,
  extracted_computer_number text,
  extracted_year integer,
  extracted_month integer,
  status text not null default 'needs_review' check (status in ('needs_review','imported','discarded')),
  notes text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- from faculty_salary_archive.sql
create table if not exists public.faculty_salary_pages (
  id bigint generated by default as identity primary key,
  file_name text not null,
  file_url text not null,
  period_year integer not null,
  period_month integer not null check (period_month between 1 and 12),
  page_number integer not null,
  text_content text not null,
  page_image_url text,
  created_at timestamptz not null default now()
);

-- from optimize_database_performance.sql
-- ============================================
-- Ã˜Â¥Ã˜Â¶Ã˜Â§Ã™ÂÃ˜Â© archive Ã™â€žÃ™â€žÃ˜Â¨Ã™Å Ã˜Â§Ã™â€ Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ™â€šÃ˜Â¯Ã™Å Ã™â€¦Ã˜Â©
-- ============================================

-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â¬Ã˜Â¯Ã˜Â§Ã™Ë†Ã™â€ž Ã™â€žÃ™â€žÃ˜Â£Ã˜Â±Ã˜Â´Ã™ÂÃ˜Â©
CREATE TABLE IF NOT EXISTS faculty_salary_pages_archive (
  LIKE faculty_salary_pages INCLUDING ALL
);

-- from create_service_requests_tables.sql
-- Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜Â·Ã™â€žÃ˜Â¨Ã˜Â§Ã˜Âª Ã˜Â§Ã™â€žÃ˜Â²Ã™â€¦Ã˜Â§Ã™â€žÃ˜Â©
CREATE TABLE IF NOT EXISTS fellowship_requests (
