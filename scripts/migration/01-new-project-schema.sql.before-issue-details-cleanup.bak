-- from create_executive_orders_archive.sql
-- 2. Ã˜Â§Ã™â€žÃ˜Â£Ã™Ë†Ã˜Â§Ã™â€¦Ã˜Â± Ã˜Â§Ã™â€žÃ˜ÂªÃ™â€ Ã™ÂÃ™Å Ã˜Â°Ã™Å Ã˜Â© (Ã™Æ’Ã™â€ž Ã˜ÂµÃ™Â = Ã˜Â£Ã™â€¦Ã˜Â± Ã˜Â£Ã™ÂÃ˜Â¶Ã™Å Ã™Â Ã˜Â¥Ã™â€žÃ™â€° Ã™â€¦Ã™â€žÃ™Â Ã˜Â´Ã˜Â®Ã˜Âµ)
