  status VARCHAR(20) DEFAULT 'Ã™â€¦Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž' CHECK (status IN ('Ã™â€¦Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž', 'Ã˜Â¬Ã˜Â§Ã˜Â±Ã™Å ', 'Ã™â€¦Ã™Æ’Ã˜ÂªÃ™â€¦Ã™â€ž', 'Ã™â€¦Ã™â€žÃ˜ÂºÃ™Å ')),
  target_audience VARCHAR(100),
  created_by UUID REFERENCES users(id),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- from create_performance_and_courses_tables.sql
-- Ã˜Â¥Ã™â€ Ã˜Â´Ã˜Â§Ã˜Â¡ Ã˜Â¬Ã˜Â¯Ã™Ë†Ã™â€ž Ã˜ÂªÃ˜Â³Ã˜Â¬Ã™Å Ã™â€ž Ã˜Â§Ã™â€žÃ™â€¦Ã™Ë†Ã˜Â¸Ã™ÂÃ™Å Ã™â€  Ã™ÂÃ™Å  Ã˜Â§Ã™â€žÃ˜Â¯Ã™Ë†Ã˜Â±Ã˜Â§Ã˜Âª
