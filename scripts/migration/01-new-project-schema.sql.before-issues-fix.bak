-- ==== create_scanner_inbox.sql ====================================
-- ÙÙ‡Ø±Ø³ Ù„Ù„Ø¨Ø­Ø« Ø§Ù„Ø³Ø±ÙŠØ¹ ÙÙŠ Ø§Ù„Ù…Ø³Ø­ÙˆØ­Ø§Øª Ø§Ù„Ù…Ø¹Ù„Ù‘Ù‚Ø©
