-- --------------------------------------------------------------------------
-- 2) ØªÙØ¹ÙŠÙ„ RLS Ø¹Ù„Ù‰ Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù…ÙŠÙ† Ù…Ø¹ Ø³ÙŠØ§Ø³Ø§Øª ØªØ­Ø§ÙØ¸ Ø¹Ù„Ù‰ ÙˆØ¸Ø§Ø¦Ù Ø§Ù„ØªØ·Ø¨ÙŠÙ‚ Ø§Ù„Ø­Ø§Ù„ÙŠØ©
--    (Ù‚Ø±Ø§Ø¡Ø©/ÙƒØªØ§Ø¨Ø© Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù…ÙŠÙ† ØªØ¨Ù‚Ù‰ Ù„Ù„Ø£Ù†ÙˆÙ† ÙƒÙ…Ø§ Ù‡ÙŠ Ù„ØªØ³ØªÙ…Ø± Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù…ÙŠÙ†
--    Ù…Ù† Ø¯Ø§Ø®Ù„ Ø§Ù„ØªØ·Ø¨ÙŠÙ‚Ø› Ø§Ù„ÙØ§Ø¦Ø¯Ø© Ù‡Ù†Ø§ ØªÙˆØ«ÙŠÙ‚ Ø§Ù„Ø³ÙŠØ§Ø³Ø§Øª ÙˆØªÙ…Ù‡ÙŠØ¯ Ø§Ù„ØªÙ‚ÙŠÙŠØ¯ Ù„Ø§Ø­Ù‚Ù‹Ø§).
-- --------------------------------------------------------------------------
ALTER TABLE public.users ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "anon_select_users" ON public.users;

CREATE POLICY "anon_select_users" ON public.users
  FOR SELECT TO anon USING (true);

-- Ø¨Ø¹Ø¯ Ù†Ù‚Ù„ ØªØ³Ø¬ÙŠÙ„ Ø§Ù„Ø¯Ø®ÙˆÙ„ Ø¥Ù„Ù‰ Edge Function (Ø§Ù„Ù‚Ø³Ù… 3) Ø§Ø­Ø°Ù Ù‡Ø°Ù‡ Ø§Ù„Ø³ÙŠØ§Ø³Ø©
-- ÙˆØ§Ø³ØªØ¨Ø¯Ù„Ù‡Ø§ Ø¨Ø³ÙŠØ§Ø³Ø© Ù„Ø§ ØªØ³Ù…Ø­ Ø¨Ù‚Ø±Ø§Ø¡Ø© Ø¹Ù…ÙˆØ¯ password:
--   CREATE POLICY "anon_select_users" ON public.users
--     FOR SELECT TO anon USING (true);
