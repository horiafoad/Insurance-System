--   Ø§Ù„Ø¬Ø³Ø± Ø§Ù„Ø¬Ø¯ÙŠØ¯ (scanner-bridge) ØµØ§Ø± ÙŠØ±ÙØ¹ Ø¥Ù„Ù‰ Cloudflare R2 Ø¹Ø¨Ø± Ø¯Ø§Ù„Ø© Ø­Ø§ÙØ©
--   scanner-uploadØŒ ÙØµØ§Ø± Ø¬Ø¯ÙˆÙ„ scanner_inbox ÙŠØ­ØªØ§Ø¬:
--     1) storage_provider / storage_key  â† ÙŠØ¹ØªÙ…Ø¯ Ø¹Ù„Ù‰ add_r2_storage_columns.sql
--        (Ù†ÙØ³ Ø§Ù„Ø£Ø¹Ù…Ø¯Ø© Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù…Ø© ÙÙŠ Ø¨Ø§Ù‚ÙŠ Ø¬Ø¯Ø§ÙˆÙ„ Ø§Ù„Ù…Ø´Ø±ÙˆØ¹)
--     2) source_fingerprint  â† Ø¹Ù…ÙˆØ¯ Ø¬Ø¯ÙŠØ¯ Ø®Ø§Øµ Ø¨Ø§Ù„Ù…Ø³Ø­ÙˆØ¨Ø§Øª Ù„Ù…Ù†Ø¹ Ø§Ù„ØªÙƒØ±Ø§Ø±
--
--   Ø£ÙÙØ±Ø¯Øª ÙÙŠ Ù…Ù„Ù Ù…Ù†ÙØµÙ„ Ù„Ø£Ù† (2) ØªØºÙŠÙŠØ± Ø®Ø§Øµ Ø¨Ø¬Ø¯ÙˆÙ„ ÙˆØ§Ø­Ø¯ ÙÙ‚Ø·ØŒ ÙˆÙ„Ø£Ù†
--   add_r2_storage_columns.sql ÙŠÙØ·Ø¨ÙŽÙ‘Ù‚ Ø¹Ù„Ù‰ 12 Ø¬Ø¯ÙˆÙ„Ù‹Ø§ ÙˆÙŠÙÙ†ÙÙŽÙ‘Ø° Ù‚Ø¨Ù„ Ù‡Ø°Ø§ Ø§Ù„Ù…Ù„Ù.
--
-- Ø§Ù„ØªØ´ØºÙŠÙ„: Supabase Dashboard -> SQL Editor -> New query -> Run
--
-- âš ï¸ Ø¢Ù…Ù† ØªÙ…Ø§Ù…Ù‹Ø§:
--   â€¢ ÙƒÙ„ Ø§Ù„Ø¹Ù…Ù„ÙŠØ§Øª ADD COLUMN IF NOT EXISTS â€” Ù„Ø§ ÙŠÙØ­Ø°Ù Ø´ÙŠØ¡ ÙˆÙ„Ø§ ÙŠÙØ¹Ø¯ÙŽÙ‘Ù„ ØµÙ Ù…ÙˆØ¬ÙˆØ¯
--   â€¢ Ø§Ù„ØµÙÙˆÙ Ø§Ù„Ù‚Ø¯ÙŠÙ…Ø© (file_url Ø±ÙˆØ§Ø¨Ø· http) ØªØ¨Ù‚Ù‰ ÙƒÙ…Ø§ Ù‡ÙŠ ÙˆØªÙÙ‚Ø±Ø£ Ù…Ù† Supabase
--   â€¢ unique index Ø¬Ø²Ø¦ÙŠ Ø¹Ù„Ù‰ Ø§Ù„Ø¹Ù…ÙˆØ¯ Ø§Ù„Ø¬Ø¯ÙŠØ¯ ÙÙ‚Ø·ØŒ ÙØ§Ù„ØµÙÙˆÙ Ø§Ù„Ù‚Ø¯ÙŠÙ…Ø© NULL Ù„Ø§ ØªØªØ£Ø«Ø±
--   â€¢ Ø¥Ø¹Ø§Ø¯Ø© Ø§Ù„ØªØ´ØºÙŠÙ„ Ø¢Ù…Ù†Ø© (idempotent)
-- =============================================================================

-- 1) Ø§Ù„ØªØ£ÙƒØ¯ Ù…Ù† ÙˆØ¬ÙˆØ¯ Ø¬Ø¯ÙˆÙ„ scanner_inbox (Ù„Ø§ Ù†Ù†Ø´Ø¦Ù‡ Ù‡Ù†Ø§ â€” Ø£Ù†Ø´Ø£Ù‡ create_scanner_inbox.sql)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.tables
    WHERE table_schema = 'public' AND table_name = 'scanner_inbox'
  ) THEN
    RAISE EXCEPTION 'Ø¬Ø¯ÙˆÙ„ public.scanner_inbox ØºÙŠØ± Ù…ÙˆØ¬ÙˆØ¯ â€” Ù†ÙÙ‘Ø° create_scanner_inbox.sql Ø£ÙˆÙ„Ù‹Ø§.';
  END IF;
END $$;

-- Ø§Ù„ØµÙÙˆÙ Ø§Ù„Ù‚Ø¯ÙŠÙ…Ø© supabase Ø¯Ø§Ø¦Ù…Ù‹Ø§Ø› Ù„Ø§ Ù†Ø¹ØªÙ…Ø¯ Ø¹Ù„Ù‰ NULL Ù„Ø£Ù†Ù‡ Ù‚Ø¯ ÙŠØ¹Ù†ÙŠ "ØºÙŠØ± Ù…Ø¹Ø±ÙˆÙ"
UPDATE public.scanner_inbox
   SET storage_provider = 'supabase'
 WHERE storage_provider IS NULL;

-- Ù‚ÙŠØ¯ Ø§Ù„Ù‚ÙŠÙ… Ø§Ù„Ù…Ø³Ù…ÙˆØ­Ø© â€” ÙÙ‚Ø· 'supabase' Ø£Ùˆ 'r2'
