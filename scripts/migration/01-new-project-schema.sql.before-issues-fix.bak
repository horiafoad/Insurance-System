-- Ø¥Ø¶Ø§ÙØ© ØªØ¹Ù„ÙŠÙ‚ Ø¹Ù„Ù‰ Ø§Ù„Ø¬Ø¯ÙˆÙ„
COMMENT ON TABLE employee_tasks IS 'Ø¬Ø¯ÙˆÙ„ Ù…Ù‡Ø§Ù… Ù…ÙˆØ¸ÙÙŠ Ù‚Ø³Ù… Ø§Ù„Ø§Ø³ØªØ­Ù‚Ø§Ù‚Ø§Øª';

-- ============================================
-- Ø¥Ø¶Ø§ÙØ© Ø¨ÙŠØ§Ù†Ø§Øª ØªØ¬Ø±ÙŠØ¨ÙŠØ©
-- ============================================

-- Ù…Ù‡Ø§Ù… Ù„ÙƒÙ„ Ù…ÙˆØ¸Ù - Ø´Ù‡Ø± Ø£ØºØ³Ø·Ø³ 2026

-- [REMOVED by build-new-schema] sample/reference seed for a table whose rows come from the OLD export


-- ============================================
-- Ø§Ø³ØªØ¹Ù„Ø§Ù…Ø§Øª Ù…ÙÙŠØ¯Ø©
-- ============================================

-- Ø¹Ø±Ø¶ Ø¬Ù…ÙŠØ¹ Ø§Ù„Ù…Ù‡Ø§Ù… Ù…Ø¹ Ø§Ø³Ù… Ø§Ù„Ù…ÙˆØ¸Ù
SELECT 
  t.id,
  t.employee_id,
  CASE t.employee_id
    WHEN 1 THEN 'ØµÙØ§Ø¡ Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 2 THEN 'ÙŠØ§Ø³Ù…ÙŠÙ† Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 3 THEN 'Ø­ÙˆØ±ÙŠØ© ÙØ¤Ø§Ø¯'
    WHEN 4 THEN 'Ø£Ù…Ø§Ù†ÙŠ ØµÙ„Ø§Ø­'
    WHEN 5 THEN 'Ø¹Ø¨Ø¯ Ø§Ù„Ù„Ù‡ Ø§Ù„Ø³Ø¹ÙŠØ¯'
    WHEN 6 THEN 'Ø¬Ù‡Ø§Ø¯ Ø¹Ø§Ø·Ù'
  END as employee_name,
  t.title,
  t.description,
  t.due_date,
  t.task_month,
  t.task_year,
  t.status,
  t.priority,
  t.created_at
FROM employee_tasks t
ORDER BY t.created_at DESC;

-- Ø¹Ø±Ø¶ Ù…Ù„Ø®Øµ Ø§Ù„Ù…Ù‡Ø§Ù… Ù„ÙƒÙ„ Ù…ÙˆØ¸Ù Ø­Ø³Ø¨ Ø§Ù„Ø´Ù‡Ø±
SELECT 
  employee_id,
  CASE employee_id
    WHEN 1 THEN 'ØµÙØ§Ø¡ Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 2 THEN 'ÙŠØ§Ø³Ù…ÙŠÙ† Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 3 THEN 'Ø­ÙˆØ±ÙŠØ© ÙØ¤Ø§Ø¯'
    WHEN 4 THEN 'Ø£Ù…Ø§Ù†ÙŠ ØµÙ„Ø§Ø­'
    WHEN 5 THEN 'Ø¹Ø¨Ø¯ Ø§Ù„Ù„Ù‡ Ø§Ù„Ø³Ø¹ÙŠØ¯'
    WHEN 6 THEN 'Ø¬Ù‡Ø§Ø¯ Ø¹Ø§Ø·Ù'
  END as employee_name,
  task_month,
  task_year,
  COUNT(*) as total_tasks,
  SUM(CASE WHEN status = 'Ù…ÙƒØªÙ…Ù„' THEN 1 ELSE 0 END) as completed,
  SUM(CASE WHEN status = 'Ø¬Ø¯ÙŠØ¯' OR status = 'Ø¬Ø§Ø±ÙŠ' THEN 1 ELSE 0 END) as pending,
  SUM(CASE WHEN status = 'Ù…ØªØ£Ø®Ø±' THEN 1 ELSE 0 END) as late
FROM employee_tasks
GROUP BY employee_id, task_month, task_year
ORDER BY task_year DESC, task_month DESC, employee_id;

-- Ø¹Ø±Ø¶ Ø§Ù„Ù…Ù‡Ø§Ù… Ø§Ù„Ù…ØªØ£Ø®Ø±Ø©
SELECT 
  t.*,
  CASE t.employee_id
    WHEN 1 THEN 'ØµÙØ§Ø¡ Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 2 THEN 'ÙŠØ§Ø³Ù…ÙŠÙ† Ø¹Ø¨Ø¯ Ø§Ù„ÙˆÙ‡Ø§Ø¨'
    WHEN 3 THEN 'Ø­ÙˆØ±ÙŠØ© ÙØ¤Ø§Ø¯'
    WHEN 4 THEN 'Ø£Ù…Ø§Ù†ÙŠ ØµÙ„Ø§Ø­'
    WHEN 5 THEN 'Ø¹Ø¨Ø¯ Ø§Ù„Ù„Ù‡ Ø§Ù„Ø³Ø¹ÙŠØ¯'
    WHEN 6 THEN 'Ø¬Ù‡Ø§Ø¯ Ø¹Ø§Ø·Ù'
  END as employee_name
FROM employee_tasks t
WHERE t.status = 'Ù…ØªØ£Ø®Ø±' OR (t.due_date < CURRENT_DATE AND t.status != 'Ù…ÙƒØªÙ…Ù„')
ORDER BY t.due_date ASC;

-- Ø¹Ø±Ø¶ Ù…Ù‡Ø§Ù… Ù…ÙˆØ¸Ù Ù…Ø¹ÙŠÙ† Ù„Ø´Ù‡Ø± Ù…Ø¹ÙŠÙ†
SELECT * FROM employee_tasks
WHERE employee_id = 1 AND task_month = 8 AND task_year = 2026
ORDER BY due_date ASC;


