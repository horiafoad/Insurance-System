create index if not exists idx_fsa_member
  on public.faculty_salary_archive (computer_number, faculty_name);
create index if not exists idx_fsa_year_month
  on public.faculty_salary_archive (year, month);
create index if not exists idx_fsa_name_search
  on public.faculty_salary_archive using gin (to_tsvector('simple', faculty_name));
create index if not exists idx_fsi_status
  on public.faculty_salary_imports (status);
