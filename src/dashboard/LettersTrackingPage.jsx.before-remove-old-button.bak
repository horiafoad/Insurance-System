                        fontSize: "16px",
                      }}
                    >
                      {scannedLetter.movements?.find(
                        (movement) => movement.status === "in_progress"
                      )?.department?.name || "لا توجد محطة حالية"}
                    </div>
                  </div>
                </div>

                <div style={{ marginTop: "16px" }}>
                  <label
