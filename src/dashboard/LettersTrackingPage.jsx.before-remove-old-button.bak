                    }}
                  >
                    {"📝 ملاحظات الاستلام"}
                  </label>
                  <textarea
                    value={receivedNotes}
                    onChange={(event) => setReceivedNotes(event.target.value)}
                    placeholder="اكتبي ملاحظات الاستلام إن وجدت..."
                    rows={3}
                    style={{
