        {/* الرحلة */}
        {movements.length === 0 ? (
          <div
            style={{
              padding:
                "50px 20px",
              textAlign:
                "center",
              background:
                "#FFFFFF",
              borderRadius:
                "18px",
              color: "#64748B",
              border:
                "1px dashed #CBD5E1",
