              "1px solid rgba(255,255,255,0.08)",
            top: "-120px",
            left: "-50px",
          }}
        />

        <div
          style={{
            position: "absolute",
            width: "150px",
            height: "150px",
            borderRadius: "50%",
            background:
              "rgba(255,255,255,0.04)",
            bottom: "-80px",
            right: "15%",
          }}
        />

        <div
          style={{
            position: "relative",
            display: "flex",
            justifyContent:
              "space-between",
            alignItems: "center",
            gap: "20px",
            flexWrap: "wrap",
          }}
        >
          <div
            style={{
              display: "flex",
              alignItems: "center",
              gap: "16px",
            }}
          >
            <div
              style={{
                width: "64px",
                height: "64px",
                minWidth: "64px",
                borderRadius: "18px",
                background:
                  "rgba(255,255,255,0.12)",
                border:
                  "1px solid rgba(255,255,255,0.20)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: "32px",
                boxShadow:
                  "0 10px 25px rgba(0,0,0,0.12)",
              }}
            >
              âœ‰ï¸
            </div>

            <div>
              <div
                style={{
                  fontSize: "12px",
