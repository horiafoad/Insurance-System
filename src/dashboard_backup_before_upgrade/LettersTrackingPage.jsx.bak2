   ========================================================= */

function InfoBox({
  label,
  value,
  ltr = false,
  highlight = false,
}) {
  return (
    <div
      style={{
        background:
          highlight
            ? "linear-gradient(135deg,#EFF6FF,#F8FAFC)"
            : "#FFFFFF",
        border:
          "1px solid " +
          (highlight
            ? "#BFDBFE"
            : "#E2E8F0"),
        borderRadius:
          "14px",
        padding:
          "14px 15px",
        boxShadow:
          "0 3px 10px rgba(15,23,42,0.025)",
      }}
    >
      <div
        style={{
          fontSize: "10px",
          color: "#94A3B8",
          marginBottom: "7px",
          fontWeight: "700",
        }}
      >
        {label}
      </div>

      <div
        style={{
          fontSize: "14px",
          fontWeight: "800",
          color:
            highlight
              ? "#1D4ED8"
              : "#0F172A",
          direction:
            ltr ? "ltr" : "rtl",
          textAlign:
            ltr ? "left" : "right",
          lineHeight: "1.6",
        }}
      >
        {value}
      </div>
    </div>
  );
}

