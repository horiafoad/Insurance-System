/* =========================================================
   Header Button
   ========================================================= */

function headerButtonStyle(
  background
) {
  return {
    border:
      "1px solid rgba(255,255,255,0.18)",
    borderRadius:
      "11px",
    padding:
      "10px 15px",
    background,
    color: "#fff",
    fontSize:
      "13px",
    fontWeight:
      "700",
    cursor:
      background ===
      "#64748B"
        ? "not-allowed"
        : "pointer",
    backdropFilter:
      "blur(8px)",
  };
}

/* =========================================================
   Date
   ========================================================= */

function formatDate(value) {
  if (!value) {
    return "â€”";
  }

  try {
    return new Intl.DateTimeFormat(
      "ar-EG",
      {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }
    ).format(new Date(value));
  } catch {
    return "â€”";
  }
}

/* =========================================================
   Date + Time
   ========================================================= */

function formatDateTime(
  value
) {
  if (!value) {
    return "â€”";
  }

  try {
    return new Intl.DateTimeFormat(
      "ar-EG",
      {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
      }
    ).format(new Date(value));
  } catch {
    return "â€”";
  }
}

