# انسخ هذا الملف إلى .env وضع القيم الحقيقية (لا تضع أي أسرار في Git)

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLISHABLE_ANON_KEY
VITE_VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_PUBLISHABLE_VAPID_KEY

# دعم فني عن بُعد — MeshCentral (لا تُضَع أي كلمة مرور هنا)
VITE_MESH_CENTRAL_URL=https://localhost

# ---------------------------------------------------------------------
# تخزين الملفات (Supabase Storage / Cloudflare R2)
# ---------------------------------------------------------------------
# مزوّد الرفع الجديد. الافتراضي "supabase" = السلوك الحالي كما هو.
# غيّره إلى "r2" فقط بعد إكمال خطوات R2_SETUP_GUIDE.md كاملة.
# هذا ليس سرًا — اسم المزوّد فقط.
# VITE_FILE_STORAGE_PROVIDER=supabase

# ---------------------------------------------------------------------
# متغيرات R2 و service-role — لا تُكتب في هذا الملف ولا في أي .env
# ---------------------------------------------------------------------
# هذه قيم سرّية أو حسّاسة. سكربت الترحيل
# (scripts/migrate-storage-to-r2.mjs) يقرأها من process.env حصرًا،
# ويتجاهل أي نسخة منها موجودة في .env مع تحذير.
#
# اضبطها في PowerShell في جلستك الطرفية فقط (وليس في ملفات المشروع):
#
#   $env:SUPABASE_SERVICE_ROLE_KEY = "<service-role key>"
#   $env:R2_ACCOUNT_ID             = "<Cloudflare Account ID>"
#   $env:R2_ACCESS_KEY_ID          = "<R2 Access Key ID>"
#   $env:R2_SECRET_ACCESS_KEY      = "<R2 Secret Access Key>"
#   $env:R2_BUCKET_NAME            = "<R2 bucket name>"
#
# و VITE_SUPABASE_URL يقرأ من البيئة أولًا ثم من .env (ليس سرًّا).
#
# اضبط نفس قيم R2 كـ Supabase Edge secrets لتشغيل Edge Function:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME

# ---------------------------------------------------------------------
# جسر السكانر (scanner-bridge)
# ---------------------------------------------------------------------
# SCANNER_BRIDGE_TOKEN توكن سري يشاركه الجسر مع دالة scanner-upload فقط.
#   • أنشئهStrong وعشوائيًا (24 حرفًا على الأقل) مثل:
#       node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#   • ضع نفس القيمة في: Supabase -> Edge Functions -> Secrets
#     باسم SCANNER_BRIDGE_TOKEN
#   • ثم ضعها هنا أو في PowerShell. الجسر لا يرسلها للمتصفح،
#     ولا تُكتب أبدًا في متغير يبدأ بـ VITE_ (وإلا ظهرت في حزمة المتصفح).
#
# ملاحظة: الجسر لا يحتاج R2_ACCESS_KEY_ID ولا R2_SECRET_ACCESS_KEY ولا
# service_role إطلاقًا — الرفع والتسجيل يحدثان داخل دالة scanner-upload.
#
# SCANNER_BRIDGE_TOKEN=ضع_نفس_القيمة_التي_أضفتها_في_Edge_secrets_هنا
#
# اختياري — عنوان الدالة لو لم يكن الافتراضي:
# SCANNER_UPLOAD_URL=https://YOUR-PROJECT.supabase.co/functions/v1/scanner-upload
